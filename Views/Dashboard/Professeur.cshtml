@{
    ViewData["Title"] = "Espace Professeur";
}

<div class="container-fluid py-4">
    <div class="text-end mt-3">
        <a href="@Url.Action("Logout", "Authentification")" class="btn btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> Déconnexion
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-dark">
                <i class="fas fa-chalkboard-teacher me-2"></i>Espace Professeur
            </h1>
            <p class="lead">Bienvenue, <strong>@User.Identity.Name</strong>.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users-class fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Mes Classes</h5>
                    <p class="card-text">Accédez à la liste de vos classes et élèves.</p>
                    <a href="@Url.Action("MesClasses", "Professeur")" class="btn btn-primary stretched-link">
                        <i class="fas fa-list-ul me-1"></i> Voir mes classes
                    </a>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-edit fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Saisir les Notes</h5>
                    <p class="card-text">Renseignez les notes des élèves.</p>
                    <a href="@Url.Action("SaisirNotes", "Professeur")" class="btn btn-warning stretched-link text-white">
                        <i class="fas fa-pen-fancy me-1"></i> Commencer
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Emploi du Temps</h5>
                    <p class="card-text">Consultez votre planning hebdomadaire.</p>
                    <a href="@Url.Action("EmploiDuTemps", "Professeur")" class="btn btn-success stretched-link">
                        <i class="fas fa-clock me-1"></i> Voir l'EDT
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-user-graduate me-2"></i>Élèves de la classe <span class="badge bg-light text-dark">Terminale A</span>
                        </h5>
                        <a href="#" class="btn btn-sm btn-outline-light">
                            <i class="fas fa-file-export me-1"></i> Exporter (.csv)
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Moyenne</th>
                                    <th>Dernière note</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                               
                                <tr>
                                    <td>Dupont</td>
                                    <td>Jean</td>
                                    <td>14.5</td>
                                    <td>15 <span class="badge bg-success">+1.5</span></td>
                                    <td>
                                        <a href="#" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Profil
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Martin</td>
                                    <td>Sophie</td>
                                    <td>12.0</td>
                                    <td>11 <span class="badge bg-danger">-1.0</span></td>
                                    <td>
                                        <a href="#" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Profil
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-bell me-2"></i>Prochains Cours (Aujourd'hui)
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>9h00 - 10h30</strong><br>
                                <span class="text-muted">Terminale A - Mathématiques</span>
                            </div>
                            <a href="#" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-clipboard-check"></i> Fiche de cours
                            </a>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>14h00 - 15h30</strong><br>
                                <span class="text-muted">Première B - Physique</span>
                            </div>
                            <a href="#" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-clipboard-check"></i> Fiche de cours
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>


        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Alertes
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-user-clock me-2"></i>
                        <strong>3 élèves</strong> en retard ce matin (Terminale A).
                    </div>
                    <div class="alert alert-light">
                        <i class="fas fa-user-slash me-2"></i>
                        <strong>1 absence</strong> non justifiée (Martin Sophie).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        $(document).ready(function() {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}