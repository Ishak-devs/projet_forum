@{
    ViewData["Title"] = "Espace Professeur";
    var profNomComplet = $"{ViewBag.ProfPrenom} {ViewBag.ProfNom}";
    var classes = ViewBag.Classes as List<Promos>;
    var alertes = ViewBag.Alertes as List<Alertes>;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #858796;
            --light-color: #f8f9fc;
            --dark-color: #5a5c69;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card-hover {
            transition: all 0.3s ease;
            border: 1px solid #e3e6f0;
            border-radius: 0.35rem;
        }

            .card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }

        .bg-icon {
            background-color: rgba(78, 115, 223, 0.1);
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .divider {
            height: 1px;
            background-color: rgba(0,0,0,0.1);
            margin: 1rem 0;
        }

        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-outline-primary:hover {
                background-color: var(--primary-color);
                color: white;
            }

        .alert-item {
            border-left: 3px solid;
            transition: all 0.2s;
        }

            .alert-item:hover {
                background-color: #f8f9fc;
            }

        .absence {
            border-left-color: #e74a3b;
        }

        .retard {
            border-left-color: #f6c23e;
        }

        .info {
            border-left-color: #36b9cc;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <!-- Header Section -->
        <header class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h3 mb-1 text-gray-800">
                    <i class="fas fa-chalkboard-teacher text-primary me-2"></i>Espace Professeur
                </h1>
                <p class="text-muted mb-0">Bienvenue, <span class="fw-bold">@profNomComplet</span></p>
            </div>
            <a href="@Url.Action("Logout", "Authentification")" class="btn btn-outline-secondary">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </header>

        @if (TempData["Message"] != null)
        {
        <div class="alert alert-warning alert-dismissible fade show mb-4">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        }

        <!-- Quick Actions Section -->
        <section class="mb-5">
            <h2 class="h5 mb-3 text-gray-800">Actions rapides</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card card-hover h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-icon me-3">
                                    <i class="fas fa-users text-primary"></i>
                                </div>
                                <h5 class="mb-0">Ma Classe</h5>
                            </div>
                            <p class="text-muted small mb-3">Gestion des élèves et de la classe</p>
                            <a href="@Url.Action("MesClasses", "Professeur")" class="btn btn-outline-primary btn-sm stretched-link">
                                Accéder <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-hover h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-icon me-3">
                                    <i class="fas fa-file-upload text-primary"></i>
                                </div>
                                <h5 class="mb-0">Ajouter un document</h5>
                            </div>
                            <p class="text-muted small mb-3">Publier un devoir pour la classe</p>
                            <a href="@Url.Action("AjouterDevoir", "Professeur")" class="btn btn-outline-primary btn-sm stretched-link">
                                Ajouter <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-hover h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-icon me-3">
                                    <i class="fas fa-edit text-primary"></i>
                                </div>
                                <h5 class="mb-0">Saisir notes</h5>
                            </div>
                            <p class="text-muted small mb-3">Enregistrement des évaluations</p>
                            <a href="@Url.Action("SaisirNotes", "Professeur")" class="btn btn-outline-primary btn-sm stretched-link">
                                Commencer <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-hover h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-icon me-3">
                                    <i class="fas fa-calendar-alt text-primary"></i>
                                </div>
                                <h5 class="mb-0">Emploi du temps</h5>
                            </div>
                            <p class="text-muted small mb-3">Consultation du planning</p>
                            <a href="@Url.Action("EmploiDuTemps", "Professeur")" class="btn btn-outline-primary btn-sm stretched-link">
                                Voir EDT <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Content Section -->
        <div class="row">
            <!-- Ma Classe Section -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-users me-2 text-gray-500"></i>
                            Ma Classe
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Classe != null)
                        {
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-icon me-3">
                                <i class="fas fa-door-open text-primary"></i>
                            </div>
                            <div>
                                <h4 class="mb-1">@ViewBag.Classe?.Nom_classe</h4>
                                <span class="badge bg-light text-dark">Année scolaire 2024-2025</span>
                            </div>
                        </div>

                        <div class="divider"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-user-graduate fa-lg"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Liste des élèves</h6>
                                        <p class="text-muted small mb-0">Gestion complète des élèves</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-book fa-lg"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Programme</h6>
                                        <p class="text-muted small mb-0">Matières enseignées</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        }
                        else
                        {
                        <div class="text-center py-4">
                            <div class="bg-icon mx-auto mb-3">
                                <i class="fas fa-door-open text-primary"></i>
                            </div>
                            <h5 class="fw-light">Aucune classe assignée</h5>
                            <p class="text-muted">Une classe vous sera bientôt assignée</p>
                        </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Alertes Section -->


            <h2>Alertes récentes</h2>

            @if (alertes != null && alertes.Any())
{
            <ul>
                @foreach (var alerte in alertes)
        {
                <li>
                    <strong>@alerte.Titre</strong><br />
                    @alerte.Message<br />
                    <small>@alerte.date_alerte.ToString("dd/MM/yyyy HH:mm")</small>
                </li>
        }
            </ul>
}
else
{
            <p>Aucune alerte disponible.</p>
}


            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>