@{
    ViewData["Title"] = "Espace Professeur";
    var profNomComplet = $"{ViewBag.ProfPrenom} {ViewBag.ProfNom}";
    var classes = ViewBag.Classes as List<Promos>;
    var alertes = ViewBag.Alertes as List<Alertes>;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #858796;
            --light-color: #f8f9fc;
            --dark-color: #5a5c69;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%);
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-left: 4px solid var(--primary-color);
        }

        .card-hover {
            transition: all 0.3s ease;
            border: 1px solid #e3e6f0;
            border-radius: 0.5rem;
            height: 100%;
        }

            .card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1);
            }

        .card-header {
            background-color: white;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 600;
            padding: 1rem 1.5rem;
            border-radius: 0.5rem 0.5rem 0 0 !important;
        }

        .bg-icon {
            background-color: rgba(78, 115, 223, 0.1);
            width: 3.5rem;
            height: 3.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            margin-bottom: 1rem;
        }

        .divider {
            height: 1px;
            background-color: rgba(0,0,0,0.1);
            margin: 1.5rem 0;
        }

        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
        }

            .btn-outline-primary:hover {
                background-color: var(--primary-color);
                color: white;
            }

        .alert-item {
            border-left: 4px solid;
            transition: all 0.2s;
            padding: 1rem;
            margin-bottom: 0.75rem;
            border-radius: 0.5rem;
            background-color: white;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
        }

            .alert-item:hover {
                transform: translateX(5px);
                box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
            }

        .absence {
            border-left-color: #e74a3b;
        }

        .retard {
            border-left-color: #f6c23e;
        }

        .info {
            border-left-color: #36b9cc;
        }

        .badge-pill {
            border-radius: 10rem;
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 500;
        }

        .dashboard-section {
            margin-bottom: 2.5rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--dark-color);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #f0f0f0;
        }

            .section-title i {
                margin-right: 0.75rem;
                color: var(--primary-color);
            }

        .quick-action-card {
            text-align: center;
            padding: 1.5rem 1rem;
        }

            .quick-action-card h5 {
                font-size: 1rem;
                font-weight: 600;
                margin-bottom: 0.5rem;
            }

        .quick-action-icon {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--primary-color);
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <!-- Header Section -->
        <header class="dashboard-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2">
                        <i class="fas fa-chalkboard-teacher text-primary me-2"></i>Espace Professeur
                    </h1>
                    <p class="mb-0 text-muted">Bienvenue, <span class="fw-bold text-dark">@profNomComplet</span></p>
                </div>
                <a href="@Url.Action("Logout", "Authentification")" class="btn btn-outline-secondary">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </header>

        @if (TempData["Message"] != null)
        {
        <div class="alert alert-warning alert-dismissible fade show mb-4">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        }

        <!-- Quick Actions Section -->
        <section class="dashboard-section">
            <h2 class="section-title"><i class="fas fa-bolt"></i>Actions rapides</h2>
            <div class="row g-4">
                <div class="col-md-3 col-6">
                    <div class="card card-hover">
                        <a href="@Url.Action("MesClasses", "Professeur")" class="text-decoration-none text-dark">
                            <div class="card-body quick-action-card">
                                <div class="quick-action-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <h5>Ma Classe</h5>
                                <p class="text-muted small mb-0">Gérer mes élèves</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-3 col-6">
                    <div class="card card-hover">
                        <a href="@Url.Action("AjouterDevoir", "Professeur")" class="text-decoration-none text-dark">
                            <div class="card-body quick-action-card">
                                <div class="quick-action-icon">
                                    <i class="fas fa-file-upload"></i>
                                </div>
                                <h5>Ressources</h5>
                                <p class="text-muted small mb-0">Gérer les documents</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-3 col-6">
                    <div class="card card-hover">
                        <a href="@Url.Action("SaisirNotes", "Professeur")" class="text-decoration-none text-dark">
                            <div class="card-body quick-action-card">
                                <div class="quick-action-icon">
                                    <i class="fas fa-edit"></i>
                                </div>
                                <h5>Saisir notes</h5>
                                <p class="text-muted small mb-0">Enregistrer évaluations</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-3 col-6">
                    <div class="card card-hover">
                        <a href="@Url.Action("EmploiDuTemps", "Professeur")" class="text-decoration-none text-dark">
                            <div class="card-body quick-action-card">
                                <div class="quick-action-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <h5>Emploi du temps</h5>
                                <p class="text-muted small mb-0">Voir planning</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Content Section -->
        <div class="row">
            <!-- Alertes Section -->
            <div class="col-lg-12">
                <section class="dashboard-section">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-bell me-2"></i>
                                Alertes récentes
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (alertes != null && alertes.Any())
                            {
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="list-group list-group-flush">
                                        @foreach (var alerte in alertes)
                                            {
                                        <div class="alert-item info mb-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <strong class="text-dark">@alerte.Titre</strong>
                                                <small class="text-muted">@alerte.date_alerte.ToString("dd/MM/yyyy à HH:mm")</small>
                                            </div>
                                            <p class="mb-0">@alerte.Message</p>
                                        </div>
                                            }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="bg-light p-4 rounded text-center h-100">
                                        <div class="bg-icon mx-auto mb-3">
                                            <i class="fas fa-info-circle text-primary"></i>
                                        </div>
                                        @*<h5>Gestion des alertes</h5>
                                        <p class="text-muted small">Consultez et gérez toutes vos notifications en un seul endroit</p>
                                        <a href="@Url.Action("Alertes", "Professeur")" class="btn btn-primary btn-sm">
                                            Voir toutes les alertes
                                        </a>*@
                                    </div>
                                </div>
                            </div>
                            }
                            else
                            {
                            <div class="text-center py-5">
                                <div class="bg-icon mx-auto mb-3">
                                    <i class="fas fa-bell-slash text-muted"></i>
                                </div>
                                <h5 class="fw-light">Aucune alerte récente</h5>
                                <p class="text-muted">Vous serez notifié lorsqu'une nouvelle alerte sera disponible</p>
                            </div>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>