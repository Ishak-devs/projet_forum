@{
    ViewData["Title"] = "Espace Professeur";
    var profNomComplet = $"{ViewBag.ProfPrenom} {ViewBag.ProfNom}";
    var classes = ViewBag.Classes as List<Classes>;
    var alertes = ViewBag.Alertes as List<Alertes>;
}

<div class="container-fluid py-4 professor-dashboard">
    <!-- Header Section with decorative elements -->
    <div class="professor-header position-relative p-4 mb-4 rounded-3" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">
        <div class="position-absolute top-0 end-0 mt-3 me-3">
            <a href="@Url.Action("Logout", "Authentification")" class="btn btn-light btn-sm shadow-sm">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>

        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold text-white mb-3">
                    <i class="fas fa-chalkboard-teacher me-2"></i>Espace Professeur
                </h1>
                <p class="lead text-white-50 mb-0">Bienvenue, <span class="text-white fw-bold">@profNomComplet</span></p>
            </div>
            <div class="col-md-4 text-md-end">
                <img src="https://cdn-icons-png.flaticon.com/512/3134/3134332.png" alt="Teacher Illustration" class="img-fluid d-none d-md-block" style="max-height: 120px; filter: drop-shadow(0 0 10px rgba(0,0,0,0.2));">
            </div>
        </div>

        <div class="position-absolute bottom-0 start-0 w-100 overflow-hidden" style="line-height: 0;">
            <svg class="w-100" style="height: 30px;" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="#fff"></path>
                <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" fill="#fff"></path>
                <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,233.58-87.2V0Z" fill="#fff"></path>
            </svg>
        </div>
    </div>

    <!-- Quick Actions with decorative cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card action-card h-100 border-0 shadow-lg" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                <div class="card-body p-4 text-center position-relative">
                    <div class="icon-wrapper bg-primary shadow mb-4 mx-auto">
                        <i class="fas fa-users-class fa-2x text-white"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Mes Classes</h5>
                    <p class="card-text text-muted mb-4">Gérez vos classes et consultez les listes d'élèves</p>
                    <a href="@Url.Action("MesClasses", "Professeur")" class="btn btn-primary btn-rounded px-4">
                        <i class="fas fa-list-ul me-2"></i> Accéder
                    </a>
                    <div class="position-absolute bottom-0 end-0 me-3 mb-3">
                        <i class="fas fa-arrow-right text-primary opacity-25 fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card action-card h-100 border-0 shadow-lg" style="background: linear-gradient(135deg, #fff1eb 0%, #ace0f9 100%);">
                <div class="card-body p-4 text-center position-relative">
                    <div class="icon-wrapper bg-warning shadow mb-4 mx-auto">
                        <i class="fas fa-edit fa-2x text-white"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Saisir les Notes</h5>
                    <p class="card-text text-muted mb-4">Renseignez et modifiez les notes des élèves</p>
                    <a href="@Url.Action("SaisirNotes", "Professeur")" class="btn btn-warning btn-rounded px-4 text-white">
                        <i class="fas fa-pen-fancy me-2"></i> Commencer
                    </a>
                    <div class="position-absolute bottom-0 end-0 me-3 mb-3">
                        <i class="fas fa-arrow-right text-warning opacity-25 fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card action-card h-100 border-0 shadow-lg" style="background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);">
                <div class="card-body p-4 text-center position-relative">
                    <div class="icon-wrapper bg-success shadow mb-4 mx-auto">
                        <i class="fas fa-calendar-alt fa-2x text-white"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Emploi du Temps</h5>
                    <p class="card-text text-muted mb-4">Consultez votre planning hebdomadaire</p>
                    <a href="@Url.Action("EmploiDuTemps", "Professeur")" class="btn btn-success btn-rounded px-4">
                        <i class="fas fa-clock me-2"></i> Voir l'EDT
                    </a>
                    <div class="position-absolute bottom-0 end-0 me-3 mb-3">
                        <i class="fas fa-arrow-right text-success opacity-25 fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content with decorative sections -->
    <div class="row mb-5">
        <!-- Classes Section -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-users text-primary me-2"></i>
                            <span class="text-gradient">Vos Classes</span>
                        </h5>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                            <button class="btn btn-sm btn-primary">
                                <i class="fas fa-plus me-1"></i> Ajouter
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (classes != null && classes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Classe</th>
                                        <th>Niveau</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var classe in classes)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="class-icon bg-light-primary rounded-circle me-3">
                                                        <i class="fas fa-door-open text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">@classe.Nom_classe</h6>
                                                        <small class="text-muted">@classe.ProfesseurPrincipal</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary">Secondaire</span>
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a href="@Url.Action("DetailsClasse", "Professeur", new { id = classe.Id_classe })"
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    <i class="fas fa-eye me-1"></i> Détails
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                            <h5 class="fw-light">Aucune classe assignée</h5>
                            <p class="text-muted">Vous n'êtes actuellement assigné à aucune classe</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">Total: @(classes?.Count ?? 0) classes</small>
                        <a href="#" class="btn btn-sm btn-link">Voir tout <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Events & Alerts Section -->
        <div class="col-lg-4">
            <!-- Upcoming Courses -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-day text-info me-2"></i>
                        <span class="text-gradient">Prochains Cours</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (classes != null && classes.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var classe in classes.Take(2))
                            {
                                <div class="list-group-item border-0 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="time-badge bg-info bg-opacity-10 text-info rounded p-2 me-3 text-center">
                                            <span class="d-block fw-bold">@DateTime.Today.AddHours(8).ToString("HH:mm")</span>
                                            <small>@DateTime.Today.AddHours(9).ToString("HH:mm")</small>
                                        </div>
                                        <div>
                                            <h6 class="mb-1">@classe.Nom_classe</h6>
                                            <small class="text-muted">Mathématiques • Salle @(new Random().Next(100, 300))</small>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="list-group-item border-0 py-3 bg-light">
                                <a href="#" class="btn btn-sm btn-outline-info rounded-pill w-100">
                                    <i class="fas fa-calendar-week me-1"></i> Voir la semaine
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-times fa-2x text-muted mb-3"></i>
                            <h6 class="fw-light">Aucun cours prévu</h6>
                            <p class="text-muted small">Votre emploi du temps semble libre</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Alerts Section -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0">
                        <i class="fas fa-bell text-danger me-2"></i>
                        <span class="text-gradient">Alertes Récentes</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (alertes != null && alertes.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var alerte in alertes.Take(3))
                            {
                                <div class="list-group-item border-0 py-3">
                                    <div class="d-flex">
                                        <div class="alert-icon me-3">
                                            <i class="fas @(alerte.Message == "Absence" ? "fa-user-slash text-danger" : alerte.Message == "Retard" ? "fa-user-clock text-warning" : "fa-info-circle text-info") fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1">@alerte.Titre</h6>
                                            <p class="small mb-0 text-muted">@alerte.Message</p>
                                            <small class="text-muted">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-2x text-success mb-3"></i>
                            <h6 class="fw-light">Tout va bien !</h6>
                            <p class="text-muted small">Aucune alerte en ce moment</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Footer -->
    <div class="row mt-5">
        <div class="col-12 text-center">
            <div class="d-inline-block p-3 rounded-3 bg-light">
                <i class="fas fa-quote-left text-muted me-2"></i>
                <span class="fst-italic text-muted">L'éducation est l'arme la plus puissante qu'on puisse utiliser pour changer le monde.</span>
                <i class="fas fa-quote-right text-muted ms-2"></i>
                <div class="mt-2">
                    <small class="text-muted">- Nelson Mandela</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .professor-dashboard {
        background-color: #f8f9fa;
    }

    .professor-header {
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .action-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
    }

    .action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

    .btn-rounded {
        border-radius: 50px;
    }

    .class-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .time-badge {
        min-width: 60px;
    }

    .text-gradient {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 600;
    }

    .alert-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(220, 53, 69, 0.1);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Animation for cards
            $('.action-card').each(function(index) {
                $(this).delay(100 * index).animate({ opacity: 1 }, 300);
            });
        });
    </script>
}