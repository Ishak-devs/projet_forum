                                       </div>
                                       <h5 class="card-title mb-0">Emplois du temps</h5>
                                   </div>
                                   <p class="card-text text-muted">Planifiez et organisez les emplois du temps des classes et enseignants.</p>
                                   <a href="@Url.Action("Ajouter_emplois_du_temps", "Modules")" class="btn btn-outline-warning stretched-link">
                                       <i class="fas fa-clock me-1"></i> Gérer les plannings
                                   </a>
                               </div>
                           </div>
                       </div>

                       <div class="col-md-4">
