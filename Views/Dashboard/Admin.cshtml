                       <div class="col-md-4">
                           <div class="card border-primary h-100">
                               <div class="card-body">
                                   <div class="d-flex align-items-center mb-3">
                                       <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                                           <i class="fas fa-users fa-2x text-primary"></i>
                                       </div>
                                       <h5 class="card-title mb-0">Gestion des Promotions</h5>
                                   </div>
                                   <p class="card-text text-muted">Créez et gérez les promotions de l'établissement pour l'année scolaire en cours.</p>
                                   <a href="@Url.Action("Ajouterclasse", "Classe")" class="btn btn-outline-primary stretched-link">
                                       <i class="fas fa-plus-circle me-1"></i> Ajouter une promotion
                                   </a>
                               </div>
                           </div>
                       </div>

