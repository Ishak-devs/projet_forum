                                       <h5 class="mb-3"><i class="fas fa-calendar-day text-primary me-2"></i>Prochains Événements</h5>

                                       <div class="row g-4">
                                           <!-- Événement 1 -->
                                           <div class="col-md-6 col-lg-4">
                                               <div class="card h-100 border-start border-4 border-primary">
                                                   <div class="card-body">
                                                       <div class="d-flex align-items-start mb-3">
                                                           <div class="bg-primary text-white rounded-2 p-3 me-3 text-center" style="width: 60px;">
                                                               <div class="fw-bold">15</div>
                                                               <div class="small">JUIN</div>
                                                           </div>
                                                           <div>
                                                               <h5 class="card-title mb-1">Journée Portes Ouvertes</h5>
                                                               <p class="text-muted small mb-2"><i class="fas fa-clock me-1"></i> 09:00 - 17:00</p>
                                                               <p class="card-text">Découverte de l'établissement pour les futurs élèves et leurs parents.</p>
                                                           </div>
                                                       </div>
                                                       <div class="d-flex justify-content-between align-items-center">
                                                           <span class="badge bg-primary bg-opacity-10 text-primary">Tous publics</span>
                                                           <a href="#" class="btn btn-sm btn-outline-primary">Détails</a>
                                                       </div>
                                                   </div>
                                               </div>
                                           </div>

                                           <!-- Événement 2 -->
                                           <div class="col-md-6 col-lg-4">
                                               <div class="card h-100 border-start border-4 border-success">
                                                   <div class="card-body">
                                                       <div class="d-flex align-items-start mb-3">
                                                           <div class="bg-success text-white rounded-2 p-3 me-3 text-center" style="width: 60px;">
                                                               <div class="fw-bold">22</div>
                                                               <div class="small">JUIN</div>
                                                           </div>
                                                           <div>
                                                               <h5 class="card-title mb-1">Spectacle de Fin d'Année</h5>
                                                               <p class="text-muted small mb-2"><i class="fas fa-clock me-1"></i> 18:30 - 21:00</p>
                                                               <p class="card-text">Présentation des talents des élèves : théâtre, musique et danse.</p>
                                                           </div>
                                                       </div>
                                                       <div class="d-flex justify-content-between align-items-center">
                                                           <span class="badge bg-success bg-opacity-10 text-success">Culturel</span>
                                                           <a href="#" class="btn btn-sm btn-outline-success">Détails</a>
                                                       </div>
                                                   </div>
                                               </div>
                                           </div>

                                           <!-- Événement 3 -->
                                           <div class="col-md-6 col-lg-4">
                                               <div class="card h-100 border-start border-4 border-warning">
                                                   <div class="card-body">
                                                       <div class="d-flex align-items-start mb-3">
                                                           <div class="bg-warning text-white rounded-2 p-3 me-3 text-center" style="width: 60px;">
                                                               <div class="fw-bold">28</div>
                                                               <div class="small">JUIN</div>
                                                           </div>
                                                           <div>
                                                               <h5 class="card-title mb-1">Remise des Diplômes</h5>
                                                               <p class="text-muted small mb-2"><i class="fas fa-clock me-1"></i> 14:00 - 16:30</p>
                                                               <p class="card-text">Cérémonie officielle de remise des diplômes aux élèves de terminale.</p>
                                                           </div>
                                                       </div>
                                                       <div class="d-flex justify-content-between align-items-center">
                                                           <span class="badge bg-warning bg-opacity-10 text-warning">Cérémonie</span>
                                                           <a href="#" class="btn btn-sm btn-outline-warning">Détails</a>
                                                       </div>
                                                   </div>
                                               </div>
                                           </div>
                                       </div>
                                   </div>

                                   <!-- Calendrier des événements -->
                                   <div class="p-4 bg-light">
                                       <h5 class="mb-3"><i class="fas fa-calendar-alt text-primary me-2"></i>Calendrier des Événements</h5>

                                       <div class="table-responsive">
                                           <table class="table table-bordered">
                                               <thead class="table-light">
                                                   <tr>
                                                       <th>Date</th>
                                                       <th>Événement</th>
                                                       <th>Type</th>
                                                       <th>Public</th>
                                                       <th>Actions</th>
                                                   </tr>
                                               </thead>
                                               <tbody>
                                                   <tr>
                                                       <td>15/06</td>
                                                       <td>Journée Portes Ouvertes</td>
                                                       <td><span class="badge bg-primary">Information</span></td>
                                                       <td>Tous publics</td>
                                                       <td>
                                                           <button class="btn btn-sm btn-outline-primary">Détails</button>
                                                       </td>
                                                   </tr>
                                                   <tr>
                                                       <td>18/06</td>
                                                       <td>Olympiades Sportives</td>
                                                       <td><span class="badge bg-info">Sport</span></td>
                                                       <td>Élèves</td>
                                                       <td>
                                                           <button class="btn btn-sm btn-outline-info">Détails</button>
                                                       </td>
                                                   </tr>
                                                   <tr>
                                                       <td>22/06</td>
                                                       <td>Spectacle de Fin d'Année</td>
                                                       <td><span class="badge bg-success">Culture</span></td>
                                                       <td>Familles</td>
                                                       <td>
                                                           <button class="btn btn-sm btn-outline-success">Détails</button>
                                                       </td>
                                                   </tr>
                                                   <tr>
                                                       <td>28/06</td>
                                                       <td>Remise des Diplômes</td>
                                                       <td><span class="badge bg-warning">Cérémonie</span></td>
                                                       <td>Terminales</td>
                                                       <td>
                                                           <button class="btn btn-sm btn-outline-warning">Détails</button>
                                                       </td>
                                                   </tr>
                                               </tbody>
                                           </table>
                                       </div>
                                   </div>
                               </div>
                           </div>
                       </div>
                   </div>

                   <style>
                       .event-card {
                           transition: transform 0.3s ease, box-shadow 0.3s ease;
                       }

                           .event-card:hover {
                               transform: translateY(-5px);
                               box-shadow: 0 10px 20px rgba(0,0,0,0.1);
                           }

                       .calendar-event {
                           cursor: pointer;
                       }

                           .calendar-event:hover {
                               background-color: #f8f9fa;
                           }
                   </style>

                   <script>
                       // Script pour la gestion des événements
                       document.addEventListener('DOMContentLoaded', function () {
                           // Ajouter un effet au survol des cartes d'événements
                           const eventCards = document.querySelectorAll('.card');
                           eventCards.forEach(card => {
                               card.addEventListener('mouseenter', function () {
                                   this.classList.add('shadow-sm');
                               });
                               card.addEventListener('mouseleave', function () {
                                   this.classList.remove('shadow-sm');
                               });
                           });


                           const calendarRows = document.querySelectorAll('.calendar-event');
                           calendarRows.forEach(row => {
                               row.addEventListener('click', function () {

                                   console.log('Événement sélectionné:', this.cells[1].textContent);
                               });
                           });
                       });
                   </script>

                   <!-- Section Alerte aux élèves -->
                   <div class="col-md-8">
                       <form id="alertForm" asp-action="AjouterAlerte" asp-controller="Dashboard" method="post">
                           @Html.AntiForgeryToken()

                           <div class="mb-3">
                               <label for="promotionSelect" class="form-label">Sélectionner une promotion</label>
                               <select class="form-select" id="promotionSelect" name="Id_classe" required>
                                   <option value="" selected disabled>Choisir une promotion...</option>
                                   @foreach (var classe in Model)
                {
                                   <option value="@classe.Id_classe">@classe.Nom_classe</option>
                }
                               </select>
                           </div>

                           <div class="mb-3">
                               <label for="alertType" class="form-label">Titre de l'alerte</label>
                               <input type="text" class="form-control" id="alertType" name="alertType" placeholder="Titre court et clair" required>
                           </div>

                           <div class="mb-3">
                               <label for="alertMessage" class="form-label">Message</label>
                               <textarea class="form-control" id="alertMessage" name="message" rows="4" placeholder="Détails de l'alerte..." required></textarea>
                           </div>

                           <div class="d-flex justify-content-end">
                               <button type="submit" class="btn btn-warning">
                                   <i class="fas fa-paper-plane me-1"></i> Envoyer l'alerte
                               </button>
                           </div>
                       </form>
                   </div>

                   @section Scripts {
                       <script>
                           document.addEventListener('DOMContentLoaded', function () {
                               const alertForm = document.getElementById('alertForm');

                               alertForm.addEventListener('submit', function (e) {
                                   e.preventDefault();


                                   const submitBtn = alertForm.querySelector('button[type="submit"]');
                                   submitBtn.disabled = true;
                                   submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Envoi en cours...';

                                   const formData = new FormData(alertForm);


                                   const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                                   formData.append('__RequestVerificationToken', token);

                                   fetch(alertForm.action, {
                                       method: 'POST',
                                       body: formData,
                                       headers: {
                                           'Accept': 'application/json',
                                           'RequestVerificationToken': token
                                       }
                                   })
                                       .then(response => {
                                           submitBtn.disabled = false;
                                           submitBtn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Envoyer l\'alerte';

                                           if (!response.ok) {
                                               throw new Error(`Erreur HTTP: ${response.status}`);
                                           }


                                           if (response.redirected) {
                                               window.location.href = response.url;
                                               return;
                                           }

                                           return response.json();
                                       })
                                       .then(data => {
                                           if (data) {
                                               showToast('success', data.message || 'Alerte envoyée avec succès');
                                           }
                                       })
                                       .catch(error => {
                                           console.error('Erreur:', error);
                                           showToast('danger', 'Erreur réseau: ' + error.message);
                                           submitBtn.disabled = false;
                                           submitBtn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Envoyer l\'alerte';
                                       });

                                   function showToast(type, message) {
                                       const toastContainer = document.createElement('div');
                                       toastContainer.className = 'position-fixed bottom-0 end-0 p-3';
                                       toastContainer.style.zIndex = '11';

                                       const toastHtml = `
                                               <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                                                   <div class="toast-header bg-${type} text-white">
                                                       <strong class="me-auto">${type === 'success' ? 'Succès' : 'Erreur'}</strong>
                                                       <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                                                   </div>
                                                   <div class="toast-body">
                                                       ${message}
                                                   </div>
                                               </div>
                                           `;

                                       toastContainer.innerHTML = toastHtml;
                                       document.body.appendChild(toastContainer);

                                       setTimeout(() => {
                                           toastContainer.remove();
                                       }, 5000);
                                   }
                               });
                           });
                       </script>
                   }