@model List<Forum.Models.Classes>
    @{
    ViewData["Title"] = "Administration - Gestion Établissement Scolaire";
    }

               <div class="container-fluid py-4">
                   <div class="row mb-4">
                       <div class="col-12">
                           <div class="d-flex align-items-center mb-3">
                               <i class="fas fa-university fa-2x text-primary me-3"></i>
                               <div>
                                   <h1 class="h2 fw-bold text-dark mb-0">Gestion de l'Établissement Scolaire</h1>
                                   <p class="text-muted mb-0">Tableau de bord administratif</p>
                               </div>
                           </div>

                           @if (TempData["NomEtablissementCree"] != null)
            {
                           <div class="alert alert-primary alert-dismissible fade show" role="alert">
                               <i class="fas fa-check-circle me-2"></i>
                               <strong>École @TempData["NomEtablissementCree"]</strong> - Gestion administrative
                               <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                           </div>
            }
