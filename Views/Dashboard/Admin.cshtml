@model List<Forum.Models.Classes>
    @{
    ViewData["Title"] = "Administration - Gestion Établissement Scolaire";
    }

    <div class="container-fluid py-4">
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-university fa-2x text-primary me-3"></i>
                    <div>
                        <h1 class="h2 fw-bold text-dark mb-0">Gestion de l'Établissement Scolaire</h1>
                        <p class="text-muted mb-0">Tableau de bord administratif</p>
                    </div>
                </div>

                @if (TempData["NomEtablissementCree"] != null)
            {
                <div class="alert alert-primary alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>École @TempData["NomEtablissementCree"]</strong> - Gestion administrative
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            </div>
        </div>

        <!-- Cartes d'actions rapides -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-primary h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                            <h5 class="card-title mb-0">Gestion des Promotions</h5>
                        </div>
                        <p class="card-text text-muted">Créez et gérez les promotions de l'établissement pour l'année scolaire en cours.</p>
                        <a href="@Url.Action("Ajouterclasse", "Classe")" class="btn btn-outline-primary stretched-link">
                            <i class="fas fa-plus-circle me-1"></i> Ajouter une promotion
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-warning h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
                                <i class="fas fa-calendar-alt fa-2x text-warning"></i>
                            </div>
                            <h5 class="card-title mb-0">Emplois du temps</h5>
                        </div>
                        <p class="card-text text-muted">Planifiez et organisez les emplois du temps des classes et enseignants.</p>
                        <a href="@Url.Action("Ajouter_emplois_du_temps", "Modules")" class="btn btn-outline-warning stretched-link">
                            <i class="fas fa-clock me-1"></i> Gérer les plannings
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-success h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 p-3 rounded me-3">
                                <i class="fas fa-user-tie fa-2x text-success"></i>
                            </div>
                            <h5 class="card-title mb-0">Gestion des Utilisateurs</h5>
                        </div>
                        <p class="card-text text-muted">Enregistrez et gérez les comptes des élèves, enseignants et personnels.</p>
                        <a href="@Url.Action("Inscrire_utilisateur", "Signup")" class="btn btn-outline-success stretched-link">
                            <i class="fas fa-user-plus me-1"></i> Inscrire un utilisateur
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau des promotions -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-list-ol text-primary me-2"></i>Promotions Actives
                            </h5>
                            <div>
                                <a href="@Url.Action("Liste_classe", "Dashboard")" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye me-1"></i> Voir toutes les promotions
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Promotion</th>
                                        <th>Effectif</th>
                                        <th>Professeur principal</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var classe in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">@classe.Nom_classe</td>
                                        <td>
                                            @{
                                                int nombre_etudiant = 0;
                                                if (ViewBag.EffectifsParClasse != null && ViewBag.EffectifsParClasse.ContainsKey(classe.Id_classe))
                                                {
                                                    nombre_etudiant = ViewBag.EffectifsParClasse[classe.Id_classe];
                                                }
                                            }
                                            <span class="badge bg-primary bg-opacity-10 text-primary">@nombre_etudiant élèves</span>
                                        </td>
                                        <td>

                                            @foreach (var item in ViewBag.prof_principal ?? Enumerable.Empty<dynamic>())
                                            {
                                                if (item?.Classe?.Id_classe != null &&
                                                classe?.Id_classe != null &&
                                                item.Classe.Id_classe == classe.Id_classe)
                                                {
                                                    @if (item.ProfPrincipal != null)
                                                    {
                                                        <span class="d-inline-block">
                                                            <i class="fas fa-chalkboard-teacher text-muted me-1"></i>
                                                            @item.ProfPrincipal.Nom @item.ProfPrincipal.Prenom
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="d-inline-block text-muted">
                                                            <i class="fas fa-chalkboard-teacher me-1"></i>
                                                            Professeur non attribué
                                                        </span>
                                                    }
                                                }
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="#" class="btn btn-outline-secondary" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="#" class="btn btn-outline-danger" title="Supprimer">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-line text-primary me-2"></i>Statistiques de l'établissement
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <canvas id="statsChart" height="250"></canvas>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex flex-column h-100 justify-content-center">
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-muted mb-3">Effectifs totaux</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                                                <i class="fas fa-users text-primary"></i>
                                            </div>
                                            <div>
                                                <h3 class="mb-0">120</h3>
                                                <small class="text-muted">Élèves inscrits</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-muted mb-3">Personnel enseignant</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
                                                <i class="fas fa-chalkboard-teacher text-warning"></i>
                                            </div>
                                            <div>
                                                <h3 class="mb-0">15</h3>
                                                <small class="text-muted">Enseignants</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="text-uppercase text-muted mb-3">Promotions actives</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-success bg-opacity-10 p-2 rounded me-3">
                                                <i class="fas fa-graduation-cap text-success"></i>
                                            </div>
                                            <div>
                                                <h3 class="mb-0">@Model.Count</h3>
                                                <small class="text-muted">Promotions</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
        // Graphique avec Chart.js
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('statsChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Élèves', 'Enseignants', 'Promotions', 'Salles', 'Cours'],
                    datasets: [{
                        label: 'Statistiques',
                        data: [120, 15, @Model.Count, 8, 32],
                        backgroundColor: [
                            'rgba(13, 110, 253, 0.7)',
                            'rgba(255, 193, 7, 0.7)',
                            'rgba(25, 135, 84, 0.7)',
                            'rgba(111, 66, 193, 0.7)',
                            'rgba(214, 51, 132, 0.7)'
                        ],
                        borderColor: [
                            'rgba(13, 110, 253, 1)',
                            'rgba(255, 193, 7, 1)',
                            'rgba(25, 135, 84, 1)',
                            'rgba(111, 66, 193, 1)',
                            'rgba(214, 51, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#fff',
                            titleColor: '#000',
                            bodyColor: '#000',
                            borderColor: '#ddd',
                            borderWidth: 1,
                            padding: 12
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        });
        </script>
    }
