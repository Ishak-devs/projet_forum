@model List<Forum.Models.Classes>
    @{
    ViewData["Title"] = "Administration - Gestion Établissement Scolaire";
    }



    <div class="container-fluid py-4">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-4 fw-bold text-primary">
                    <i class="fas fa-school me-2"></i>Gestion de l'Établissement
                </h1>

                @if (TempData["NomEtablissementCree"] != null)
            {
                <h2 class="display-4 fw-bold text-primary">
                    <i class="fas fa-school me-2"></i>Ecole @TempData["NomEtablissementCree"]
                </h2>
            }


                <p class="lead">Espace réservé à l'administration.</p>

            </div>
        </div>


        <div class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-calendar-plus fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Promotions</h5>
                        <p class="card-text">Créez une nouvelle promotion pour l'année scolaire.</p>
                        <a href="@Url.Action("Ajouterclasse", "Classe")" class="btn btn-success stretched-link">
                            <i class="fas fa-plus me-1"></i> Ajouter une promo
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-calendar-alt fa-3x text-warning mb-3"></i>
                        <h5 class="card-title">Planning</h5>
                        <p class="card-text">Plannifier les cours.</p>
                        <a href="@Url.Action("Ajouter_emplois_du_temps", "Modules")" class="btn btn-warning stretched-link text-white">
                            <i class="fas fa-clock me-1"></i> Gestion emplois du temps
                        </a>
                    </div>
                </div>
            </div>



            <div class="col-md-4">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-graduate fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Utilisateur</h5>
                        <p class="card-text">Enregistrez un nouvel utilisateur dans l'établissement.</p>
                        <a href="@Url.Action("Inscrire_utilisateur", "Signup")" class="btn btn-success stretched-link">
                            <i class="fas fa-user-plus me-1"></i> Inscrire un utilisateur
                        </a>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card shadow">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>Promotions Actives
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nom</th>
                                            <th>Nombres d'élèves</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var classe in Model)
{
                                        <tr>
                                            <td>@classe.Nom_classe</td>
                                            <td>
                                                @{
                                                int count = 0;
                                                // Vérifie si l'ID de la classe existe dans le dictionnaire
                                                if (ViewBag.EffectifsParClasse != null && ViewBag.EffectifsParClasse.ContainsKey(classe.Id_classe))
                                                {
                                                    count = ViewBag.EffectifsParClasse[classe.Id_classe];
                                                }
                                                }
                                                @count étudiants
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-edit"></i> Modifier
                                                </a>
                                                <a href="#" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i> Supprimer
                                                </a>
                                            </td>
                                        </tr>
}



                                    </tbody>
                                        </table>
                                        </div>
                                        <div class="d-flex justify-content-end mt-3">
                                            <a href="@Url.Action("Liste_classe", "Dashboard")" class="btn btn-outline-dark">
                                                <i class="fas fa-arrow-right me-1"></i> Voir toutes les promotions
                                            </a>
                                        </div>
                                        </div>
                                        </div>
                                        </div>
                                        </div>

                                        <!-- Section statistiques -->
                                        <div class="row mt-4">
                                            <div class="col-md-6">
                                                <div class="card shadow">
                                                    <div class="card-header bg-warning text-dark">
                                                        <h5 class="mb-0">
                                                            <i class="fas fa-chart-pie me-2"></i>Statistiques
                                                        </h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <canvas id="statsChart" width="100%" height="200"></canvas>
                                                        <script>
                                                            // Exemple: Graphique avec Chart.js (à adapter)
                                                            const ctx = document.getElementById('statsChart').getContext('2d');
                                                            new Chart(ctx, {
                                                                type: 'bar',
                                                                data: {
                                                                    labels: ['Élèves', 'Professeurs', 'Promotions'],
                                                                    datasets: [{
                                                                        label: 'Effectifs',
                                                                        data: [120, 15, 5],
                                                                        backgroundColor: [
                                                                            'rgba(75, 192, 192, 0.6)',
                                                                            'rgba(54, 162, 235, 0.6)',
                                                                            'rgba(153, 102, 255, 0.6)'
                                                                        ]
                                                                    }]
                                                                }
                                                            });
                                                        </script>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="card shadow">
                                                    <div class="card-header bg-danger text-white">
                                                        <h5 class="mb-0">
                                                            <i class="fas fa-bell me-2"></i>Alertes
                                                        </h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="alert alert-warning">
                                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                                            <strong>2 élèves</strong> n'ont pas encore payé les frais de scolarité.
                                                        </div>
                                                        <div class="alert alert-info">
                                                            <i class="fas fa-info-circle me-2"></i>
                                                            La <strong>promotion Terminale C</strong> n'a pas de professeur principal.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        </div>

                                        <!-- Scripts Bootstrap et Font Awesome -->
                                        @section Scripts {
                                            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                                        }
