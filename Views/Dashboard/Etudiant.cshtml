@{
    ViewData["Title"] = "Espace Élève";
}

<div class="container-fluid py-4">
    <div class="text-end mt-3">
        <a href="@Url.Action("Logout", "Authentification")" class="btn btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> Déconnexion
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-user-graduate me-2"></i>Mon Espace Personnel
                    </h1>
                    <p class="lead text-muted">Bienvenue, @User.Identity.Name</p>
                </div>
                <div>
                    @if (ViewBag.Classe != null)
                    {
                        <span class="badge rounded-pill bg-success fs-6">
                            @ViewBag.Classe
                        </span>
                    }

                </div>
            </div>
        </div>
    </div>

    <!-- Section Statistiques -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Mes Statistiques</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-info bg-opacity-10 p-3 rounded me-3">
                                    <i class="fas fa-star fa-2x text-info"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">Moyenne Générale</h6>
                                    @if (ViewBag.Moyenne != null)
                                    {
                                        <h3 class="mb-0">@ViewBag.Moyenne.ToString("0.00")/20</h3>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
                                        <i class="fas fa-clipboard-check fa-2x text-warning"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Dernières Notes</h6>
                                        @if (ViewBag.Notes != null)
                                        {
                                            <h3 class="mb-0">@ViewBag.Notes.Count</h3>
                                        }
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Dernières Notes</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Notes != null && ViewBag.Notes.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Matière</th>
                                        <th>Note</th>
                                        <th>Date</th>
                                        <th>Appréciation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var note in ViewBag.Notes)
                                    {
                                        <tr>
                                            <td>@note.Modules?.Theme_module</td>
                                            <td>
                                                <span class="badge @(note.Note >= 10 ? "bg-success" : "bg-danger")">
                                                    @note.Note.ToString("0.00")
                                                </span>
                                            </td>
                                            <td>@note.Date_note.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (note.Note >= 16)
                                                {
                                                    <span class="text-success">Excellent</span>
                                                }
                                                else if (note.Note >= 14)
                                                {
                                                    <span class="text-primary">Très bien</span>
                                                }
                                                else if (note.Note >= 12)
                                                {
                                                    <span class="text-info">Bien</span>
                                                }
                                                else if (note.Note >= 10)
                                                {
                                                    <span class="text-warning">Passable</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">Insuffisant</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>Aucune note disponible pour le moment.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section Accès Rapide -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-info mb-3"></i>
                    <h5 class="card-title">Mes Notes</h5>
                    <p class="card-text">Consultez vos résultats par matière.</p>
                    <a href="@Url.Action("MesNotes", "Etudiant")" class="btn btn-info stretched-link text-white">
                        <i class="fas fa-book-open me-1"></i> Accéder
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Mon Emploi du Temps</h5>
                    <p class="card-text">Visualisez votre planning hebdomadaire.</p>
                    <a href="@Url.Action("Emplois_du_temps", "Etudiant")" class="btn btn-primary stretched-link">
                        <i class="fas fa-clock me-1"></i> Voir
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-tasks fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Mes Devoirs</h5>
                    <p class="card-text">Liste des travaux à rendre.</p>
                    <a href="@Url.Action("MesDevoirs", "Etudiant")" class="btn btn-warning stretched-link text-white">
                        <i class="fas fa-clipboard-list me-1"></i> Voir la liste
                    </a>
                </div>
            </div>
        </div>
    </div>

 
}
