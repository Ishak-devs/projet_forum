@{
    ViewData["Title"] = "Espace Élève";
    var eleveNom = User.Identity.Name;
    var classe = ViewBag.Classe;
    var moyenne = ViewBag.Moyenne;
    var notes = ViewBag.Notes as List<Notes>; // Supposons que Notes est votre modèle
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .card-hover:hover {
            transform: translateY(-2px);
            transition: transform 0.2s ease;
        }

        .divider {
            height: 1px;
            background-color: rgba(0,0,0,0.1);
            margin: 1rem 0;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="fas fa-user-graduate text-muted me-2"></i>Espace Élève
                </h1>
                <p class="text-muted mb-0">Bienvenue, @eleveNom</p>
                @if (classe != null)
                {
                    <span class="badge bg-light text-dark mt-1">@classe</span>
                }
            </div>
            <a href="@Url.Action("Logout", "Authentification")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>

        <!-- Quick Actions Section -->
        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="card card-hover h-100 border">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light p-3 rounded me-3">
                                <i class="fas fa-chart-line text-dark fa-lg"></i>
                            </div>
                            <h5 class="mb-0">Mes Notes</h5>
                        </div>
                        <p class="text-muted small">Consultez vos résultats par matière</p>
                        <a href="@Url.Action("MesNotes", "Etudiant")" class="btn btn-outline-dark btn-sm stretched-link">
                            Accéder <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light p-3 rounded me-3">
                                <i class="fas fa-calendar-alt text-dark fa-lg"></i>
                            </div>
                            <h5 class="mb-0">Emploi du temps</h5>
                        </div>
                        <p class="text-muted small">Visualisez votre planning</p>
                        <a href="@Url.Action("Emplois_du_temps", "Etudiant")" class="btn btn-outline-dark btn-sm stretched-link">
                            Voir <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light p-3 rounded me-3">
                                <i class="fas fa-tasks text-dark fa-lg"></i>
                            </div>
                            <h5 class="mb-0">Mes Devoirs</h5>
                        </div>
                        <p class="text-muted small">Liste des travaux à rendre</p>
                        <a href="@Url.Action("MesDevoirs", "Etudiant")" class="btn btn-outline-dark btn-sm stretched-link">
                            Voir liste <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Section -->
        <div class="row">
            <!-- Statistiques Section -->
            <div class="col-lg-6 mb-4">
                <div class="card border">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-pie me-2"></i>
                            Mes Statistiques
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="bg-light p-3 rounded me-3">
                                        <i class="fas fa-star fa-lg"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Moyenne Générale</h6>
                                        @if (moyenne != null)
                                        {
                                            <h3 class="mb-0">@moyenne.ToString("0.00")/20</h3>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0">Non disponible</p>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="bg-light p-3 rounded me-3">
                                        <i class="fas fa-clipboard-check fa-lg"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Dernières Notes</h6>
                                        @if (notes != null)
                                        {
                                            <h3 class="mb-0">@notes.Count</h3>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0">Aucune note</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notes Section -->
            <div class="col-lg-6">
                <div class="card border">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0">
                            <i class="fas fa-bell me-2"></i>
                            Dernières Notes
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (notes != null && notes.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Matière</th>
                                            <th>Note</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var note in notes.Take(5))
                                        {
                                            <tr>
                                                <td>@note.Modules?.Theme_module</td>
                                                <td>
                                                    <span class="badge @(note.Note >= 10 ? "bg-success" : "bg-danger")">
                                                        @note.Note.ToString("0.00")
                                                    </span>
                                                </td>
                                                <td>@note.Date_note.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-info-circle fa-2x text-muted mb-3"></i>
                                <h6 class="fw-light">Aucune note disponible</h6>
                                <p class="text-muted small">Vos notes apparaîtront ici</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>