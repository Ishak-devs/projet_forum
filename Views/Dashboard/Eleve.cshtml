@{
    ViewData["Title"] = "Espace Élève";
}

<div class="container-fluid py-4">
    <!-- En-tête personnalisé -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-user-graduate me-2"></i>Mon Espace Personnel
                    </h1>
                    <p class="lead mb-0">Bienvenue, <strong>@User.Identity.Name</strong> (Classe: <span class="badge bg-primary">Terminale A</span>)</p>
                </div>
                <div>
                    <span class="badge rounded-pill bg-success fs-6">
                        <i class="fas fa-star me-1"></i> Moyenne Générale: <strong>14.2/20</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>

   
    <div class="row g-4 mb-4">
       
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-info mb-3"></i>
                    <h5 class="card-title">Mes Notes</h5>
                    <p class="card-text">Consultez vos résultats par matière.</p>
                    <a href="@Url.Action("MesNotes", "Etudiant")" class="btn btn-info stretched-link text-white">
                        <i class="fas fa-book-open me-1"></i> Accéder
                    </a>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Mon Emploi du Temps</h5>
                    <p class="card-text">Visualisez votre planning hebdomadaire.</p>
                    <a href="@Url.Action("Emplois_du_temps", "Etudiant")" class="btn btn-primary stretched-link">
                        <i class="fas fa-clock me-1"></i> Voir
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-tasks fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Mes Devoirs</h5>
                    <p class="card-text">Liste des travaux à rendre.</p>
                    <a href="@Url.Action("MesDevoirs", "Etudiant")" class="btn btn-warning stretched-link text-white">
                        <i class="fas fa-clipboard-list me-1"></i> Voir la liste
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Évolution des Notes
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="notesChart" width="100%" height="250"></canvas>
                    <script>

                        const ctx = document.getElementById('notesChart').getContext('2d');
                        new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai'],
                                datasets: [{
                                    label: 'Moyenne en Mathématiques',
                                    data: [12, 13.5, 14, 15, 14.5],
                                    borderColor: 'rgba(75, 192, 192, 1)',
                                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                                    fill: true
                                }]
                            },
                            options: {
                                scales: { y: { beginAtZero: false, min: 10, max: 20 } }
                            }
                        });
                    </script>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-list-ul me-2"></i>Dernières Notes
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Matière</th>
                                    <th>Note</th>
                                    <th>Commentaire</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Mathématiques</td>
                                    <td><span class="badge bg-success">15/20</span></td>
                                    <td>Très bon travail !</td>
                                    <td>10/05/2024</td>
                                </tr>
                                <tr>
                                    <td>Physique</td>
                                    <td><span class="badge bg-warning text-dark">12.5/20</span></td>
                                    <td>Peut mieux faire</td>
                                    <td>05/05/2024</td>
                                </tr>
                                <tr>
                                    <td>Histoire</td>
                                    <td><span class="badge bg-success">16/20</span></td>
                                    <td>Excellent</td>
                                    <td>02/05/2024</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-day me-2"></i>Aujourd'hui
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>8h30 - 10h00</strong><br>
                                    <span class="text-muted">Mathématiques (Salle B12)</span>
                                </div>
                                <span class="badge bg-primary">En cours</span>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>10h15 - 11h45</strong><br>
                                    <span class="text-muted">Physique-Chimie (Labo 3)</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-book me-1"></i> Préparer
                                </button>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle me-2"></i>Devoirs à Rendre
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-edit me-2"></i>
                        <strong>Dissertation de Français</strong><br>
                        Pour le <u>15/05/2024</u> - <a href="#" class="alert-link">Détails</a>
                    </div>
                    <div class="alert alert-light">
                        <i class="fas fa-flask me-2"></i>
                        <strong>Rapport de TP Physique</strong><br>
                        Pour le <u>18/05/2024</u> - <a href="#" class="alert-link">Consignes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-5px)';
                card.style.transition = 'all 0.3s ease';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'none';
            });
        });
    </script>
}