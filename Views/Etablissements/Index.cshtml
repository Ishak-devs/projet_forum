@{
    ViewData["Title"] = "Recherche d'établissements";
}

<h2>Recherche d'établissements</h2>

<form id="form-recherche">

    <label for="region">Région :</label>
    <select id="region" name="region">
        <option value="">-- Choisissez une région --</option>
        <option value="Île-de-France">Île-de-France</option>
        <option value="Occitanie">Occitanie</option>
        <option value="Auvergne-Rhône-Alpes">Auvergne-Rhône-Alpes</option>
    </select>

    <label for="niveau">Type :</label>
    <select id="niveau" name="niveau">
        <option value="">-- Choisissez un type --</option>
        <option value="Collège">Collège</option>
        <option value="Lycée">Lycée</option>
    </select>

    <button type="submit">Rechercher</button>
</form>

<hr />

<h3>Résultats :</h3>
<ul id="etablissements-list"></ul>

@section Scripts {
    <script>
        document.getElementById('form-recherche').addEventListener('submit', async function (e) {
            e.preventDefault();

            const region = document.getElementById('region').value;
            const niveau = document.getElementById('niveau').value;

              console.log("Recherche : ", region, niveau);

            if (!region || !niveau) {
                alert("Veuillez sélectionner une région et un type.");
                return;
            }

            const response = await fetch(`etablissementsAPI?region=${encodeURIComponent(region)}&niveau=${encodeURIComponent(niveau)}`);
            const data = await response.json();

            const list = document.getElementById('etablissements-list');
            list.innerHTML = "";

            if (data.length === 0) {
                list.innerHTML = "<li>Aucun établissement trouvé.</li>";
                return;
            }

            data.forEach(e => {
                const li = document.createElement("li");
                li.textContent = `${e.nom} - ${e.commune} (${e.nature})`;
                list.appendChild(li);
            });
        });
    </script>
}
