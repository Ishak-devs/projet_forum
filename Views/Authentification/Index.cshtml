@model Forum.Models.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .auth-container {
            max-width: 500px;
            margin: 0 auto;
        }

        .auth-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .auth-header {
            position: relative;
            padding-bottom: 1rem;
        }

            .auth-header:after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 50px;
                height: 3px;
                background: #0d6efd;
                border-radius: 3px;
            }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .btn-primary {
            padding: 0.5rem 1.5rem;
            font-weight: 500;
        }

        .alert {
            max-width: 500px;
            margin: 1rem auto;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-5">
        <!-- Messages d'alerte -->
        @if (ViewBag.Messagesuccess != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i> @ViewBag.Messagesuccess
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Prof_not_connect"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Prof_not_connect"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.MessageError != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-times-circle me-2"></i> @ViewBag.MessageError
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.Message_error_email != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-envelope me-2"></i> @ViewBag.Message_error_email
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Formulaire de connexion -->
        <div class="auth-container">
            <div class="auth-card card p-4">
                <!-- Header -->
                <div class="text-center auth-header mb-4">
                    <i class="fas fa-sign-in-alt fa-2x text-primary mb-3"></i>
                    <h1 class="h3 fw-bold">Connexion</h1>
                </div>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Email">
                            <i class="fas fa-envelope me-1 text-muted"></i>Email
                        </label>
                        <input class="form-control" type="email" asp-for="Email" placeholder="votre@email.com" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Email)</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium" asp-for="Password">
                            <i class="fas fa-lock me-1 text-muted"></i>Mot de passe
                        </label>
                        <input class="form-control" type="password" asp-for="Password" placeholder="Votre mot de passe" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Password)</span>
                    </div>

                   
                            
                     

                    <button class="btn btn-primary w-100 py-2 fw-medium" type="submit">
                        <i class="fas fa-sign-in-alt me-1"></i> Se connecter
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">
                        Vous n'avez pas de compte ?
                        <a href="@Url.Action("Index", "Signup")" class="text-primary fw-medium">S'inscrire</a>
                    </p>
                </div>
            </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>