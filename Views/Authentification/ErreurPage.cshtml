    <script>// Dur�e du compte � rebours en secondes (15 minutes)
        let timeLeft = 15 * 60;
        const countdownElement = document.getElementById('countdown');
        const progressBar = document.getElementById('progressBar');
        const retryButton = document.getElementById('retryButton');

        // Mettre � jour le compte � rebours chaque seconde
        const countdownInterval = setInterval(() => {
            timeLeft--;

            // Calculer les minutes et secondes restantes
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;

            // Afficher le temps format� (MM:SS)
            countdownElement.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            // Mettre � jour la barre de progression
            const progressPercentage = (timeLeft / (15 * 60)) * 100;
            progressBar.style.width = `${progressPercentage}%`;

            // Si le temps est �coul�
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                countdownElement.textContent = "00:00";
                progressBar.style.width = "0%";

                // Afficher le bouton de r�essai
                retryButton.style.display = "inline-block";

                // Mettre � jour le message
                document.querySelector(".lead").textContent = "Vous pouvez maintenant r�essayer";
                countdownElement.textContent = "Pr�t!";
                countdownElement.style.color = "#4ecdc4";
            }
        }, 1000);</script>

