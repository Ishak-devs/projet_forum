@model List<Classes>

@{
    ViewData["Title"] = "Mes Classes";
}

<h2>Mes Classes</h2>

@if (!Model.Any())
{
    <p>Vous n'êtes responsable d'aucune classe pour le moment.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom de la classe</th>
                <th>Niveau</th>
                <th>Année</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var classe in Model)
            {
                <tr>
                    <td>@classe.Nom_classe</td>
                    <td>@classe.ProfesseurPrincipal</td>
                </tr>
            }
        </tbody>
    </table>
}
