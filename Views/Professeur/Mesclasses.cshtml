@model List<Forum.Models.Classes>
@{
    ViewData["Title"] = "Mes Classes";
}

<div class="container py-4">
    <h2 class="mb-4">Mes Classes</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nom de la classe</th>
                    <th>Niveau</th>
                    <th>Année scolaire</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var classe in Model)
                {
                    <tr>
                        <td>@classe.Nom_classe</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="#">Voir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">Vous n'avez aucune classe pour le moment.</div>
    }
</div>
