@model List<Forum.Models.Promos>
@{
    ViewData["Title"] = "Mes Classes";
}

<div class="container py-4">
    <h2 class="mb-4">Ma Classe</h2>

    @if (Model != null && Model.Any())
    {
        foreach (var classe in Model)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@classe.Nom_promos</strong>
                </div>
                <div class="card-body">
                    @if (classe.Utilisateurs != null && classe.Utilisateurs.Any(u => u.Role == "Etudiant"))
                    {
                        <ul class="list-group">
                            @foreach (var eleve in classe.Utilisateurs.Where(u => u.Role == "Etudiant"))
                            {
                                <li class="list-group-item">@eleve.Prenom @eleve.Nom</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-warning">Aucun étudiant inscrit dans cette classe.</div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">Vous n'avez aucune classe pour le moment.</div>
    }
</div>
