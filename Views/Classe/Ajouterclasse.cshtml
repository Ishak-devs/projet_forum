@model Forum.Models.Promos

@{
    ViewData["Title"] = "Gestion des Promotions - Administration";
}

<div class="container-fluid px-4">
    <!-- Toast Notifications -->
    <div aria-live="polite" aria-atomic="true" class="position-relative">
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header bg-success text-white">
                    <strong class="me-auto">Succès</strong>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>



            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header bg-danger text-white">
                    <strong class="me-auto">Erreur</strong>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body">

                </div>
            </div>
        </div>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-users-class me-2"></i>Gestion des Promotions
        </h1>
        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Retour au tableau de bord
        </a>
    </div>

    <div class="row">
        <!-- Formulaire de création -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Créer une nouvelle promotion
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Ajouterclasse" method="post" id="promoForm">
                        <!-- Nom de la promotion -->
                        <div class="mb-4">
                            <label asp-for="Nom_promos" class="form-label fw-bold">Nom de la promotion</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-tag text-primary"></i>
                                </span>
                                <input asp-for="Nom_promos" class="form-control form-control-lg" placeholder="Ex: BTS SIO 2023-2025" required />
                            </div>
                            <span asp-validation-for="Nom_promos" class="text-danger small"></span>
                        </div>

                        <!-- Section Élèves -->
                        <div class="mb-4 card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="fas fa-user-graduate text-primary me-2"></i>Élèves
                                    <span class="badge bg-primary float-end">@(ViewBag.Etudiant?.Count ?? 0)</span>
                                </h5>
                            </div>
                            <div class="card-body">
                                @if (ViewBag.Etudiant != null && ViewBag.Etudiant.Count > 0)
                                {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="40px">
                                                    <input class="form-check-input" type="checkbox" id="selectAllEleves">
                                                </th>
                                                <th>Nom</th>
                                                <th>Prénom</th>
                                                <th>Email</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var eleve in ViewBag.Etudiant)
                                                {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="selectedEleves" value="@eleve.Id_utilisateur"
                                                           class="form-check-input student-checkbox" />
                                                </td>
                                                <td>@eleve.Nom</td>
                                                <td>@eleve.Prenom</td>
                                                <td class="text-muted small">@eleve.Email</td>
                                            </tr>
                                                }
                                        </tbody>
                                    </table>
                                </div>
                                }
                                else
                                {
                                <div class="alert alert-warning mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Aucun élève trouvé dans cet établissement.
                                </div>
                                }
                            </div>
                        </div>

                        <!-- Section Professeurs -->
                        <div class="mb-4 card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="fas fa-chalkboard-teacher text-primary me-2"></i>Professeurs
                                    <span class="badge bg-primary float-end">@(ViewBag.Professeurs?.Count ?? 0)</span>
                                </h5>
                            </div>
                            <div class="card-body">
                                @if (ViewBag.Professeurs != null && ViewBag.Professeurs.Count > 0)
                                {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="40px">
                                                    <input class="form-check-input" type="checkbox" id="selectAllProfs">
                                                </th>
                                                <th>Nom</th>
                                                <th>Prénom</th>
                                                <th>Matière</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var prof in ViewBag.Professeurs)
                                                {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="selectedProfs" value="@prof.Id_utilisateur"
                                                           class="form-check-input teacher-checkbox" />
                                                </td>
                                                <td>@prof.Nom</td>
                                                <td>@prof.Prenom</td>
                                                <td><span class="badge bg-info">@prof.Matiere</span></td>
                                            </tr>
                                                }
                                        </tbody>
                                    </table>
                                </div>
                                }
                                else
                                {
                                <div class="alert alert-warning mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Aucun professeur trouvé dans cet établissement.
                                </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                <i class="fas fa-save me-2"></i>Créer la promotion
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Liste des promotions existantes -->
        <div class="col-lg-4">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>Promotions existantes
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Classes != null && ViewBag.Classes.Count > 0)
                    {
                    <div class="list-group list-group-flush">
                        @foreach (var classe in ViewBag.Classes)
                            {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@classe.Nom_promos</span>
                            <form asp-action="SupprimerClasse" method="post" asp-controller="Classe"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer la promotion @classe.Nom_promos ?');">
                                <input type="hidden" name="id" value="@classe.Id_promos" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                            }
                    </div>
                    }
                    else
                    {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>Aucune promotion créée pour le moment.
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Gestion des cases à cocher "Tout sélectionner"
        document.getElementById('selectAllEleves').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.student-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        document.getElementById('selectAllProfs').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.teacher-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Auto-dismiss des toasts après 5 secondes
        document.addEventListener('DOMContentLoaded', function () {
            const toastElList = [].slice.call(document.querySelectorAll('.toast'));
            const toastList = toastElList.map(function (toastEl) {
                return new bootstrap.Toast(toastEl, { delay: 5000 });
            });
            toastList.forEach(toast => toast.show());
        });
    </script>
}