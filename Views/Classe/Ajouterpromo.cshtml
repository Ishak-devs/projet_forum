@model Forum.Models.Promos

@{
    if (ViewBag.ProfId != null)
    {
        <p class="text-success">@ViewBag.ProfId</p>
    }
}

<div class="container mt-5">
    <h2 class="mb-4">Créer une classe de discussion</h2>
    <form method="post" class="border p-4 rounded shadow-sm bg-light">

        <!-- Classe selection dropdown -->
        <div class="mb-3">
            <label asp-for="Nom_promo" class="form-label">Classe :</label>
            <select asp-for="Nom_promo" class="form-select" id="classeSelect">
                <optgroup label="Voie Générale">
                    <option value="Seconde">Seconde Générale</option>
                    <option value="Premiere">Première Générale - Spéc. Maths/Physique</option>
                    <option value="Premiere">Première Générale - Spéc. SES/HGGSP</option>
                    <option value="Terminale">Terminale Générale - Spéc. Maths/NSI</option>
                    <option value="Terminale">Terminale Générale - Spéc. SVT/Physique</option>
                </optgroup>
                <optgroup label="Voie Technologique">
                    <option value="Seconde">Seconde Technologique</option>
                    <option value="Premiere">Première STI2D</option>
                    <option value="Premiere">Première STMG</option>
                    <option value="Premiere">Première ST2S</option>
                    <option value="Terminale">Terminale STI2D</option>
                    <option value="Terminale">Terminale STMG</option>
                    <option value="Terminale">Terminale ST2S</option>
                </optgroup>
                <optgroup label="Voie Professionnelle">
                    <option value="Seconde">Seconde Bac Pro Commerce</option>
                    <option value="Seconde">Seconde Bac Pro Mélec</option>
                    <option value="Premiere">Première Bac Pro ASSP</option>
                    <option value="Premiere">Première Bac Pro GA</option>
                    <option value="Terminale">Terminale Bac Pro SN</option>
                    <option value="Terminale">Terminale Bac Pro Maintenance</option>
                </optgroup>
            </select>
        </div>

        <!-- Elèves Section -->
        <div class="mb-4 border p-3 rounded">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <button type="button" class="btn btn-sm btn-outline-primary me-2" id="searchBySectionEleve">
                        <i class="bi bi-search"></i> Ajouter un élève
                    </button>
                </div>
            </div>

            <div id="elevesListContainer" class="d-none">
                @if (ViewBag.Etudiant != null && ViewBag.Etudiant.Count > 0)
                {
                    <div class="list-group mb-3" id="allElevesList">
                        @foreach (var eleves in ViewBag.Etudiant)
                        {
                            <button type="button" class="list-group-item list-group-item-action selectable-item eleve-item"
                                    data-id="@eleves.Id_utilisateur" data-type="eleve" data-section="@eleves.Section">
                                <span class="d-flex justify-content-between align-items-center">
                                    <span>@eleves.Prenom @eleves.Nom</span>
                                    <span class="badge bg-success rounded-pill d-none">✓</span>
                                </span>
                            </button>
                        }
                    </div>
                    <input type="hidden" id="selectedEleves" name="selectedEleves" value="" />
                }
                else
                {
                    <div class="alert alert-warning">Aucun élève trouvé.</div>
                }
            </div>

            <div id="selectedElevesContainer" class="selected-items-container"></div>
        </div>

        <!-- Professeurs Section -->
        <div class="mb-4 border p-3 rounded">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <button type="button" class="btn btn-sm btn-outline-primary me-2" id="searchBySectionProf">
                        <i class="bi bi-search"></i> Ajouter un pro
                    </button>
                </div>
            </div>

            <div id="profsListContainer" class="d-none">
                @if (ViewBag.Professeurs != null && ViewBag.Professeurs.Count > 0)
                {
                    <div class="list-group mb-3">
                        @foreach (var professeur in ViewBag.Professeurs)
                        {
                            <button type="button" class="list-group-item list-group-item-action selectable-item"
                                    data-id="@professeur.Id_utilisateur" data-type="professeur">
                                <span class="d-flex justify-content-between align-items-center">
                                    <span>@professeur.Prenom @professeur.Nom</span>
                                    <span class="badge bg-success rounded-pill d-none">✓</span>
                                </span>
                            </button>
                        }
                    </div>
                    <input type="hidden" id="selectedProfs" name="selectedProfs" value="" />
                }
                else
                {
                    <div class="alert alert-warning">Aucun professeur trouvé.</div>
                }
            </div>

            <div id="selectedProfsContainer" class="selected-items-container"></div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Créer la classe</button>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            
            function filterElevesBySection(section) {
                $('.eleve-item').each(function() {
                    const eleveSection = $(this).data('section');
                    const isVisible = section === '' || eleveSection === section;
                    $(this).toggle(isVisible);
                });
            }

            $('#classeSelect').change(function() {
                const selectedClass = $(this).val();
                let section = '';

                if (selectedClass.includes('Seconde')) {
                    section = 'Seconde';
                } else if (selectedClass.includes('Premiere') || selectedClass.includes('Première')) {
                    section = 'Premiere';
                } else if (selectedClass.includes('Terminale')) {
                    section = 'Terminale';
                }

                filterElevesBySection(section);
            });


            $('#searchBySectionEleve').click(function() {
                $('#elevesListContainer').toggleClass('d-none');


                $('#classeSelect').trigger('change');
            });

            $(document).on('click', '.selectable-item', function() {
                const id = $(this).data('id');
                const type = $(this).data('type');
                const name = $(this).find('span span').first().text();

                if ($(this).hasClass('selected')) {

                    $(this).removeClass('selected');
                    $(this).find('.badge').addClass('d-none');
                    $(`#selected${type === 'eleve' ? 'Eleves' : 'Profs'}Container .badge[data-id="${id}"]`).remove();
                } else {

                    $(this).addClass('selected');
                    $(this).find('.badge').removeClass('d-none');
                    const container = $(`#selected${type === 'eleve' ? 'Eleves' : 'Profs'}Container`);
                    container.append(`
                        <div class="selected-item-badge" data-id="${id}">
                            ${name}
                            <button type="button" class="btn-remove-item" data-id="${id}" data-type="${type}">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    `);
                }

                updateHiddenFields();
            });

            $(document).on('click', '.btn-remove-item', function() {
                const id = $(this).data('id');
                const type = $(this).data('type');

                $(this).parent().remove();
                $(`.selectable-item[data-id="${id}"]`).removeClass('selected').find('.badge').addClass('d-none');

                updateHiddenFields();
            });

            function updateHiddenFields() {
                const selectedEleves = [];
                $('.selectable-item.eleve-item.selected').each(function() {
                    selectedEleves.push($(this).data('id'));
                });
                $('#selectedEleves').val(selectedEleves.join(','));

                const selectedProfs = [];
                $('.selectable-item[data-type="professeur"].selected').each(function() {
                    selectedProfs.push($(this).data('id'));
                });
                $('#selectedProfs').val(selectedProfs.join(','));
            }
        });
    </script>
}