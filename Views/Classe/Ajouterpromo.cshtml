@model Forum.Models.Promos

@{
    if (ViewBag.ProfId != null)
    {
        <p class="text-success">@ViewBag.ProfId</p>
    }
}

<div class="container mt-5">
    <h2 class="mb-4">Créer une classe de discussion</h2>
    <form method="post" class="border p-4 rounded shadow-sm bg-light">

        <div class="mb-3">
            <label asp-for="Nom_promo" class="form-label">Classe :</label>
            <select asp-for="Nom_promo" class="form-select">
                <optgroup label="Voie Générale">
                    <option>Seconde Générale</option>
                    <option>Première Générale - Spéc. Maths/Physique</option>
                    <option>Première Générale - Spéc. SES/HGGSP</option>
                    <option>Terminale Générale - Spéc. Maths/NSI</option>
                    <option>Terminale Générale - Spéc. SVT/Physique</option>
                </optgroup>
                <optgroup label="Voie Technologique">
                    <option>Seconde Technologique</option>
                    <option>Première STI2D</option>
                    <option>Première STMG</option>
                    <option>Première ST2S</option>
                    <option>Terminale STI2D</option>
                    <option>Terminale STMG</option>
                    <option>Terminale ST2S</option>
                </optgroup>
                <optgroup label="Voie Professionnelle">
                    <option>Seconde Bac Pro Commerce</option>
                    <option>Seconde Bac Pro Mélec</option>
                    <option>Première Bac Pro ASSP</option>
                    <option>Première Bac Pro GA</option>
                    <option>Terminale Bac Pro SN</option>
                    <option>Terminale Bac Pro Maintenance</option>
                </optgroup>
            </select>
        </div>
</form>
</div>