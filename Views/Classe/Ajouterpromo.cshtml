@model Forum.Models.Promos

@{
    ViewData["Title"] = "Créer une nouvelle promotion - Administration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-people-fill me-2"></i>Créer une nouvelle promotion</h3>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card-body">
                    <form asp-action="AjouterPromo" method="post">
                        <!-- Nom de la promotion -->
                        <div class="mb-4">
                            <label asp-for="Nom_promo" class="form-label fw-bold">Nom de la promotion</label>
                            <input asp-for="Nom_promo" class="form-control form-control-lg" required placeholder="Ex: Terminale S 2023" />
                            <span asp-validation-for="Nom_promo" class="text-danger small"></span>
                        </div>

                        <!-- Section Élèves -->
                        <div class="mb-4 border rounded">
                            <div class="bg-light p-3 border-bottom">
                                <h5 class="mb-0"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Élèves</h5>
                            </div>

                            <div class="p-3">
                                @if (ViewBag.Etudiant != null && ViewBag.Etudiant.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th width="50px"></th>
                                                    <th>Nom</th>
                                                    <th>Prénom</th>
                                                    <th>Niveau</th>
                                                    <th>Voie</th>
                                                    <th>Email</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var eleve in ViewBag.Etudiant)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="checkbox" name="selectedEleves" value="@eleve.Id_utilisateur"
                                                                   class="form-check-input fs-5" />
                                                        </td>
                                                        <td>@eleve.Nom</td>
                                                        <td>@eleve.Prenom</td>
                                                        <td>
                                                            <span class="badge bg-info">@eleve.Section</span>
                                                        </td>
                                                     
                                                        <td class="text-truncate" style="max-width: 200px;">@eleve.Email</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="selectAllEleves">
                                            <label class="form-check-label" for="selectAllEleves">
                                                Sélectionner tous les élèves
                                            </label>
                                        </div>
                                        <span class="badge bg-primary">@ViewBag.Etudiant.Count élèves</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Aucun élève trouvé dans cet établissement.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Section Professeurs -->
                        <div class="mb-4 border rounded">
                            <div class="bg-light p-3 border-bottom">
                                <h5 class="mb-0"><i class="bi bi-person-badge-fill text-primary me-2"></i>Professeurs</h5>
                            </div>

                            <div class="p-3">
                                @if (ViewBag.Professeurs != null && ViewBag.Professeurs.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th width="50px"></th>
                                                    <th>Nom</th>
                                                    <th>Prénom</th>
                                                    <th>Matière</th>
                                                    <th>Email</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var prof in ViewBag.Professeurs)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="checkbox" name="selectedProfs" value="@prof.Id_utilisateur"
                                                                   class="form-check-input fs-5" />
                                                        </td>
                                                        <td>@prof.Nom</td>
                                                        <td>@prof.Prenom</td>
                                                     
                                                        <td class="text-truncate" style="max-width: 200px;">@prof.Email</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="selectAllProfs">
                                            <label class="form-check-label" for="selectAllProfs">
                                                Sélectionner tous les professeurs
                                            </label>
                                        </div>
                                        <span class="badge bg-primary">@ViewBag.Professeurs.Count professeurs</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Aucun professeur trouvé dans cet établissement.
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" asp-controller="Dashboard" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-2"></i>Créer la promotion
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#selectAllEleves').change(function() {
                $('input[name="selectedEleves"]').prop('checked', this.checked);
            });

            $('#selectAllProfs').change(function() {
                $('input[name="selectedProfs"]').prop('checked', this.checked);
            });
        });
    </script>
}