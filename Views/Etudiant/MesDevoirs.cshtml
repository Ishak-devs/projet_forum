@model List<Forum.Models.Devoirs>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0">
            <i class="bi bi-journal-check me-2 text-primary"></i>Mes Devoirs par Module
        </h2>
        <span class="badge bg-primary bg-opacity-10 text-primary py-2">
            @Model.Count devoir(s) à rendre
        </span>
    </div>

    @foreach (var moduleGroup in Model.GroupBy(d => d.Modules?.Theme_module))
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h4 class="h5 mb-0">
                    <i class="bi bi-book me-2 text-info"></i>@moduleGroup.Key
                </h4>
                <span class="badge bg-info bg-opacity-10 text-info">
                    @moduleGroup.Count() devoir(s)
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Intitulé</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var devoir in moduleGroup.OrderBy(d => d.Date_devoir))
                            {
                                <tr>
                                    <td class="ps-4 align-middle">
                                        <strong>@devoir.Intitulé</strong>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge @(devoir.Date_devoir < DateTime.Now ? "bg-danger bg-opacity-10 text-danger" : "bg-secondary bg-opacity-10 text-secondary")">
                                            <i class="bi bi-calendar-event me-2"></i>
                                            @devoir.Date_devoir.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-hourglass-split me-2"></i>
                                            À rendre
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <form asp-action="RendreDevoir" asp-controller="Etudiant" enctype="multipart/form-data" method="post" class="devoir-form">
                                            <input type="hidden" name="Id_devoir" value="@devoir.Id_devoir" />

                                            <div class="input-group">
                                                <input type="file" name="fichier" class="form-control form-control-sm" required
                                                       aria-label="Fichier à envoyer" id="file-@devoir.Id_devoir">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-upload me-1"></i>Envoyer
                                                </button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success fs-1"></i>
                <h3 class="h5 mt-3">Aucun devoir à rendre</h3>
                <p class="text-muted mb-0">Vous êtes à jour sur tous vos modules</p>
            </div>
        </div>
    }
</div>

<style>
    .devoir-form .form-control-sm {
        max-width: 200px;
    }

    .card {
        border-radius: 0.5rem;
    }

    .table th {
        border-top: none;
    }
</style>