@{

    ViewData["Title"] = "Forum de discussion";
     var classes = ViewBag.Classes as List<Classes> ?? new List<Classes>();
    var utilisateurs = ViewBag.Utilisateurs as List<Utilisateurs> ?? new List<Utilisateurs>();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-9">
            <h2 class="forum-title text-center mb-4">Gestion des emplois du temps</h2>

            <div class="mb-3">
                <label for="classSelect" class="form-label">Choisissez une classe :</label>

                <select id="classSelect" name="classId" class="form-select" onchange="loadModules()">
                    <option value="">-- Sélectionnez une classe --</option>
                    @foreach (var classe in classes)
    {
                    <option value="@classe.Id_classe">@classe.Nom_classe</option>
    }
                </select>

                <select class="forum-title text-center mb-4" id="profselect">
                    <option value="">-- Sélectionnez un professeur --</option>
                </select>

                <div class="mb-4">
                    <label for="Horaire" class="form-label">Choisissez un jour et un horaire</label>
                    <select name="Horaire" class="form-select mb-4" id="horaireSelect">
                        <option value="">-- Sélectionnez un jour et un horaire --</option>
                        <option value="Lundi 08:00-09:00">Lundi 08:00 - 09:00</option>
                        <option value="Lundi 09:00-10:00">Lundi 09:00 - 10:00</option>
                        <option value="Lundi 10:00-11:00">Lundi 10:00 - 11:00</option>
                        <option value="Lundi 11:00-12:00">Lundi 11:00 - 12:00</option>
                        <option value="Lundi 12:00-13:00">Lundi 12:00 - 13:00</option>
                        <option value="Lundi 13:00-14:00">Lundi 13:00 - 14:00</option>
                        <option value="Lundi 14:00-15:00">Lundi 14:00 - 15:00</option>
                        <option value="Lundi 15:00-16:00">Lundi 15:00 - 16:00</option>
                        <option value="Lundi 16:00-17:00">Lundi 16:00 - 17:00</option>
                        <option value="Lundi 17:00-18:00">Lundi 17:00 - 18:00</option>

                        <option value="Mardi 08:00-09:00">Mardi 08:00 - 09:00</option>
                        <option value="Mardi 09:00-10:00">Mardi 09:00 - 10:00</option>
                        <option value="Mardi 10:00-11:00">Mardi 10:00 - 11:00</option>
                        <option value="Mardi 11:00-12:00">Mardi 11:00 - 12:00</option>
                        <option value="Mardi 12:00-13:00">Mardi 12:00 - 13:00</option>
                        <option value="Mardi 13:00-14:00">Mardi 13:00 - 14:00</option>
                        <option value="Mardi 14:00-15:00">Mardi 14:00 - 15:00</option>
                        <option value="Mardi 15:00-16:00">Mardi 15:00 - 16:00</option>
                        <option value="Mardi 16:00-17:00">Mardi 16:00 - 17:00</option>
                        <option value="Mardi 17:00-18:00">Mardi 17:00 - 18:00</option>

                        <option value="Mercredi 08:00-09:00">Mercredi 08:00 - 09:00</option>
                        <option value="Mercredi 09:00-10:00">Mercredi 09:00 - 10:00</option>
                        <option value="Mercredi 10:00-11:00">Mercredi 10:00 - 11:00</option>
                        <option value="Mercredi 11:00-12:00">Mercredi 11:00 - 12:00</option>
                        <option value="Mercredi 12:00-13:00">Mercredi 12:00 - 13:00</option>
                        <option value="Mercredi 13:00-14:00">Mercredi 13:00 - 14:00</option>
                        <option value="Mercredi 14:00-15:00">Mercredi 14:00 - 15:00</option>
                        <option value="Mercredi 15:00-16:00">Mercredi 15:00 - 16:00</option>
                        <option value="Mercredi 16:00-17:00">Mercredi 16:00 - 17:00</option>
                        <option value="Mercredi 17:00-18:00">Mercredi 17:00 - 18:00</option>

                        <option value="Jeudi 08:00-09:00">Jeudi 08:00 - 09:00</option>
                        <option value="Jeudi 09:00-10:00">Jeudi 09:00 - 10:00</option>
                        <option value="Jeudi 10:00-11:00">Jeudi 10:00 - 11:00</option>
                        <option value="Jeudi 11:00-12:00">Jeudi 11:00 - 12:00</option>
                        <option value="Jeudi 12:00-13:00">Jeudi 12:00 - 13:00</option>
                        <option value="Jeudi 13:00-14:00">Jeudi 13:00 - 14:00</option>
                        <option value="Jeudi 14:00-15:00">Jeudi 14:00 - 15:00</option>
                        <option value="Jeudi 15:00-16:00">Jeudi 15:00 - 16:00</option>
                        <option value="Jeudi 16:00-17:00">Jeudi 16:00 - 17:00</option>
                        <option value="Jeudi 17:00-18:00">Jeudi 17:00 - 18:00</option>

                        <option value="Vendredi 08:00-09:00">Vendredi 08:00 - 09:00</option>
                        <option value="Vendredi 09:00-10:00">Vendredi 09:00 - 10:00</option>
                        <option value="Vendredi 10:00-11:00">Vendredi 10:00 - 11:00</option>
                        <option value="Vendredi 11:00-12:00">Vendredi 11:00 - 12:00</option>
                        <option value="Vendredi 12:00-13:00">Vendredi 12:00 - 13:00</option>
                        <option value="Vendredi 13:00-14:00">Vendredi 13:00 - 14:00</option>
                        <option value="Vendredi 14:00-15:00">Vendredi 14:00 - 15:00</option>
                        <option value="Vendredi 15:00-16:00">Vendredi 15:00 - 16:00</option>
                        <option value="Vendredi 16:00-17:00">Vendredi 16:00 - 17:00</option>
                        <option value="Vendredi 17:00-18:00">Vendredi 17:00 - 18:00</option>
                    </select>
                </div>




            </div>
        </div>
    </div>


    <div class="row mt-4">
        <div class="col-md-12">
            <h3 class="mb-3">Emploi du temps</h3>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Heure/Jour</th>
                                    <th>Lundi</th>
                                    <th>Mardi</th>
                                    <th>Mercredi</th>
                                    <th>Jeudi</th>
                                    <th>Vendredi</th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td>12h-13h</td>
                                    <td>
                                        <div class="editable-slot" data-day="lundi" data-time="12-13">
                                            <span class="empty-slot text-muted">Ajouter un cours</span>
                                            <button class="btn btn-sm btn-outline-primary add-course-btn" style="display:none;">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>


                    <div class="card mt-3" id="course-form" style="display:none;">
                        <div class="card-body">
                            <h5 class="card-title">Ajouter un cours</h5>
                            <form id="addCourseForm">
                                <input type="hidden" id="selected-day">
                                <input type="hidden" id="selected-time">

                                <div class="mb-3">
                                    <label for="course-name" class="form-label">Nom du cours</label>
                                    <input type="text" class="form-control" id="course-name" placeholder="Ex: Histoire" required>
                                </div>


                                <div class="mb-3">
                                    <label for="course-room" class="form-label">Salle</label>
                                    <input type="text" class="form-control" id="course-room" placeholder="Numéro de salle">
                                </div>

                                <button type="submit" class="btn btn-primary">Ajouter</button>
                                <button type="button" class="btn btn-outline-secondary">Annuler</button>
                            </form>
                        </div>
                    </div>


                    <div class="text-end mt-3">
                        <button id="validate-btn" class="btn btn-success" disabled>
                            <i class="bi bi-check-circle"></i> Valider l'emploi du temps
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function loadModules() {
        var Profid = document.getElementById("classSelect").value;
        fetch('/Modules/GetProfByClasse?id=' + Profid)
            .then(res => res.json())
            .then(data => {
                var select = document.getElementById("profselect");
                console.log(data);
                select.innerHTML = '<option value="">-- Sélectionnez un professeur --</option>';
                data.forEach(m => {
                    select.innerHTML += `<option value="${m.id_professeur}">${m.nom} ${m.prenom} ${m.matiere}</option>`;
                });
            });
    }
</script>