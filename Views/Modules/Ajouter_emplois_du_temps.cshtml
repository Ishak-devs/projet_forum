<script>
    function loadModules() {
        var Profid = document.getElementById("classSelect").value;
        fetch('/Modules/GetProfByClasse?id=' + Profid)
            .then(res => res.json())
            .then(data => {
                var select = document.getElementById("profselect");
                console.log(data);
                select.innerHTML = '<option value="">-- Sélectionnez un professeur --</option>';
                data.forEach(m => {
                    select.innerHTML += `<option value="${m.id_professeur}">${m.nom} ${m.prenom} ${m.matiere}</option>`;
                });
            });
    }
</script>