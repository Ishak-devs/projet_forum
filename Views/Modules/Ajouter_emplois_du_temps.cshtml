@{
    ViewData["Title"] = "Gestion des emplois du temps";
    var classes = ViewBag.Classes as List<Classes> ?? new List<Classes>();
    var utilisateurs = ViewBag.Utilisateurs as List<Utilisateurs> ?? new List<Utilisateurs>();
}

@if (TempData["SuccessMessage"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    @TempData["SuccessMessage"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Éléments à placer</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="classSelect" class="form-label">Classe :</label>
                        <select id="classSelect" class="form-select" onchange="loadModules()">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var classe in classes)
                            {
                            <option value="@classe.Id_classe">@classe.Nom_classe</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="theme_module" class="form-label">Cours :</label>
                        <select id="theme_module" class="form-select">
                            <option value="">-- Sélectionnez --</option>
                            <option value="mathematiques">Mathématiques</option>
                            <option value="francais">Français</option>
                            <option value="histoire">Histoire</option>
                            <option value="geographie">Géographie</option>
                            <option value="anglais">Anglais</option>
                            <option value="physique">Physique</option>
                            <option value="chimie">Chimie</option>
                            <option value="informatique">Informatique</option>
                            <option value="sport">Sport</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="profselect" class="form-label">Professeur :</label>
                        <select id="profselect" class="form-select">
                            <option value="">-- Sélectionnez --</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button id="addCourseBtn" class="btn btn-outline-primary">
                            <i class="bi bi-plus-circle"></i> Créer un cours
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Emploi du temps</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered timetable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%">Heures</th>
                                    <th style="width: 18%">Lundi</th>
                                    <th style="width: 18%">Mardi</th>
                                    <th style="width: 18%">Mercredi</th>
                                    <th style="width: 18%">Jeudi</th>
                                    <th style="width: 18%">Vendredi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int h = 8; h <= 17; h++)
                                {
                                <tr>
                                    <td class="hour-cell">@($"{h:00}:00 - {h+1:00}:00")</td>
                                    @foreach (var day in new[] { "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi" })
                                        {
                                    <td class="timetable-slot" data-day="@day" data-hour="@($"{h:00}:00")"
                                        ondragover="allowDrop(event)" ondrop="drop(event)">
                                        <!-- Les cours seront ajoutés ici par drag & drop -->
                                    </td>
                                        }
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-end mt-3">
                <button id="saveTimetableBtn" class="btn btn-success">
                    <i class="bi bi-save"></i> Enregistrer l'emploi du temps
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal pour confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Voulez-vous vraiment enregistrer cet emploi du temps ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="confirmSaveBtn">Confirmer</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timetable-slot {
            height: 60px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }

            .timetable-slot:hover {
                background-color: #f8f9fa;
            }

        .hour-cell {
            background-color: #f8f9fa;
            font-weight: 500;
        }

        .course-item {
            background-color: #e2f0fd;
            border: 1px solid #b6d4fe;
            border-radius: 4px;
            padding: 5px;
            margin: 2px 0;
            font-size: 0.85rem;
            cursor: move;
        }

            .course-item:hover {
                background-color: #cfe2ff;
            }
    </style>
}

@section Scripts {
    <script>
        // Chargement des professeurs
        function loadModules() {
            var classId = document.getElementById("classSelect").value;
            fetch('/Modules/GetProfByClasse?id=' + classId)
                .then(res => res.json())
                .then(data => {
                    var select = document.getElementById("profselect");
                    select.innerHTML = '<option value="">-- Sélectionnez --</option>';
                    data.forEach(m => {
                        select.innerHTML += `<option value="${m.id_professeur}">${m.nom} ${m.prenom} (${m.matiere})</option>`;
                    });
                });
        }


        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
        }

        function drop(ev) {
            ev.preventDefault();
            var data = ev.dataTransfer.getData("text");
            var draggedElement = document.getElementById(data);


            if (draggedElement.classList.contains('course-item')) {

                ev.target.appendChild(draggedElement);
            } else {

                var classSelect = document.getElementById("classSelect");
                var themeSelect = document.getElementById("theme_module");
                var profSelect = document.getElementById("profselect");

                if (classSelect.value && themeSelect.value && profSelect.value) {
                    var courseId = 'course-' + Date.now();
                    var courseElement = document.createElement("div");
                    courseElement.id = courseId;
                    courseElement.className = "course-item";
                    courseElement.draggable = true;
                    courseElement.ondragstart = drag;

                    var profText = profSelect.options[profSelect.selectedIndex].text;
                    courseElement.innerHTML = `
                            <strong>${themeSelect.options[themeSelect.selectedIndex].text}</strong>
                            <div>${profText}</div>
                            <button class="btn btn-sm btn-outline-danger float-end" onclick="removeCourse('${courseId}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        `;

                    ev.target.appendChild(courseElement);
                } else {
                    alert("Veuillez sélectionner une classe, un cours et un professeur");
                }
            }
        }

        function removeCourse(courseId) {
            document.getElementById(courseId).remove();
        }

        // Gestion de l'enregistrement
        document.getElementById('addCourseBtn').addEventListener('click', function () {
            var emptySlot = document.querySelector('.timetable-slot');
            if (emptySlot) {
                var event = { target: emptySlot };
                drop(event);
            }
        });

        document.getElementById('saveTimetableBtn').addEventListener('click', function () {
            var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        });

        document.getElementById('confirmSaveBtn').addEventListener('click', function () {
            
            var timetableData = [];
            var slots = document.querySelectorAll('.timetable-slot');

            slots.forEach(slot => {
                var courses = slot.querySelectorAll('.course-item');
                if (courses.length > 0) {
                    var day = slot.dataset.day;
                    var hour = slot.dataset.hour;

                    courses.forEach(course => {
                        var courseName = course.querySelector('strong').textContent;
                        var professor = course.querySelector('div').textContent;

                        timetableData.push({
                            day: day,
                            hour: hour,
                            course: courseName,
                            professor: professor
                        });
                    });
                }
            });

            fetch('/Modules/SaveTimetable', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(timetableData)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert("Erreur lors de l'enregistrement");
                    }
                });

            var modal = bootstrap.Modal.getInstance(document.getElementById('confirmModal'));
            modal.hide();
        });
    </script>
}