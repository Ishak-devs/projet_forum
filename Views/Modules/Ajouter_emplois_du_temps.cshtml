@{
    ViewData["Title"] = "Gestion des emplois du temps";
    var classes = ViewBag.Classes as List<Classes> ?? new List<Classes>();
    var utilisateurs = ViewBag.Utilisateurs as List<Utilisateurs> ?? new List<Utilisateurs>();
}

@if (TempData["SuccessMessage"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    @TempData["SuccessMessage"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Éléments à placer</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="classSelect" class="form-label">Classe :</label>
                        <select id="classSelect" class="form-select" onchange="loadModules()">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var classe in classes)
                            {
                            <option value="@classe.Id_classe">@classe.Nom_classe</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="theme_module" class="form-label">Cours :</label>
                        <input type="text" id="courseInput" name="theme_module" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="profselect" class="form-label">Professeur :</label>
                        <select id="profselect" class="form-select">
                            <option value="">-- Sélectionnez --</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button id="addCourseBtn" class="btn btn-outline-primary" onclick="prepareCourse()">
                            <i class="bi bi-plus-circle"></i> Créer un cours
                        </button>

                    </div>

                    <p id="message_confirm" class="text-success"></p>
                    <p id="message_erreur" class="text-danger"></p>

                    <!-- Zone de dépôt temporaire -->
                    <div id="tempDropZone" class="mt-3 p-2 border rounded"
                         ondragover="allowDrop(event)"
                         ondrop="drop(event)">
                        <div class="alert alert-danger text-center p-3 rounded shadow-sm" style="cursor: pointer;">
                            <i class="bi bi-trash3-fill me-2"></i> Glissez les cours ici pour les supprimer
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Emploi du temps</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered timetable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%">Heures</th>
                                    <th style="width: 18%">Lundi</th>
                                    <th style="width: 18%">Mardi</th>
                                    <th style="width: 18%">Mercredi</th>
                                    <th style="width: 18%">Jeudi</th>
                                    <th style="width: 18%">Vendredi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int h = 8; h <= 17; h++)
                                {
                                <tr>
                                    <td class="hour-cell">@($"{h:00}:00 - {h+1:00}:00")</td>
                                    @foreach (var day in new[] { "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi" })
                                        {
                                    <td class="timetable-slot" data-day="@day" data-hour="@($"{h:00}:00")"
                                        ondragover="allowDrop(event)" ondrop="drop(event)">
                                        <!-- Les cours seront ajoutés ici par drag & drop -->
                                    </td>
                                        }
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-end mt-3">
                <button id="saveTimetableBtn" class="btn btn-success">
                    <i class="bi bi-save"></i> Enregistrer l'emploi du temps
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal pour confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Voulez-vous vraiment enregistrer cet emploi du temps ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="confirmSaveBtn">Confirmer</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timetable-slot {
            height: 60px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            min-height: 60px;
        }

            .timetable-slot:hover {
                background-color: #f8f9fa;
            }

        .hour-cell {
            background-color: #f8f9fa;
            font-weight: 500;
        }

        .course-item {
            background-color: #e2f0fd;
            border: 1px solid #b6d4fe;
            border-radius: 4px;
            padding: 5px;
            margin: 2px 0;
            font-size: 0.85rem;
            cursor: move;
            position: relative;
        }

            .course-item:hover {
                background-color: #cfe2ff;
            }

        #tempDropZone {
            min-height: 50px;
            background-color: #f8f9fa;
        }

            #tempDropZone.drag-over {
                background-color: #ffeaea;
                border-color: #ff6b6b;
            }

        /* Styles pour les créneaux sélectionnables */
        .selectable-slot {
            background-color: #e8f5e9 !important;
            cursor: pointer;
            transition: all 0.3s;
        }

        .selectable-slot:hover {
            background-color: #c8e6c9 !important;
            box-shadow: 0 0 0 2px #4caf50;
        }

        .flash-animation {
            animation: flash 1s;
        }

        @*@keyframes flash {
            0% { background-color: #e8f5e9; }
            50% { background-color: #4caf50; }
            100% { background-color: #e8f5e9; }
        }*@
    </style>
}

@section Scripts {
    <script>
        // Variable pour stocker les infos du cours à placer
        let pendingCourse = null;

        // Chargement des professeurs
        function loadModules() {
            var classId = document.getElementById("classSelect").value;
            if (!classId) return;

          fetch('/Modules/GetEmploiDuTempsParClasse?id=' + classId)
            .then(res => res.json())
            .then(data => {
              console.log("Emploi du temps reçu :", data);
              
            })
            .catch(err => console.error(err));
        


            fetch('/Modules/GetProfByClasse?id=' + classId)
                .then(res => res.json())
                .then(data => {

                    var select = document.getElementById("profselect");

                           select.innerHTML = '<option value="">-- Sélectionnez --</option>';
        data.forEach(m => {
            console.log("Professeur m :", m);
            select.innerHTML += `<option value="${m.id_utilisateur}">${m.nom} ${m.prenom} (${m.matiere})</option>`;
        });
        console.log("Contenu de profselect.value :", profselect.value);

                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }

        function prepareCourse() {
            var classSelect = document.getElementById("classSelect");
            var courseInput = document.getElementById("courseInput");
            var profSelect = document.getElementById("profselect");

        console.log("Classe:", classSelect.value);
        console.log("Cours:", courseInput.value);
        console.log("Professeur:", profselect.value);


            if (!classSelect.value || !courseInput.value || !profselect.value) {
                document.getElementById("message_erreur").textContent = "Veuillez sélectionner une classe, un cours et un professeur";

                return;
            }

            pendingCourse = {
                theme: courseInput.value,
                themeValue: courseInput.value,
                Profid: profselect.value
            };

            document.getElementById("message_confirm").textContent = "Choisissez maintenant le creneaux";

            // Ajouter un style aux créneaux pour indiquer qu'ils sont sélectionnables
            const slots = document.querySelectorAll('.timetable-slot');
            slots.forEach(slot => {
                slot.classList.add('selectable-slot');
                slot.onclick = function () {
                    if (pendingCourse) {
                        placeCourse(this);
                    }
                };
            });
        }

        function placeCourse(slot) {
            if (!pendingCourse) return;
        console.log("Cours:", pendingCourse.theme);
        console.log("Professeur:", pendingCourse.Profid);


            // Vérifier si le créneau est déjà occupé
            if (slot.querySelector('.course-item')) {
                if (!confirm("Ce créneau est déjà occupé. Remplacer le cours existant ?")) {
                    return;
                }
                slot.innerHTML = ''; // Vider le créneau
            }

            // Créer l'élément du cours
            const courseId = 'course-' + Date.now();
            const courseElement = document.createElement("div");
            courseElement.id = courseId;
            courseElement.className = "course-item";
            courseElement.draggable = true;
            courseElement.ondragstart = drag;

            courseElement.innerHTML = `
                    <strong>${pendingCourse.theme}</strong>
                    <div>${pendingCourse.Profid}</div>
                    
                `;

            slot.appendChild(courseElement);

            // Réinitialiser le mode sélection
            resetSelectionMode();
        }

        function resetSelectionMode() {
            pendingCourse = null;
            const slots = document.querySelectorAll('.timetable-slot');
            slots.forEach(slot => {
                slot.classList.remove('selectable-slot');
                slot.onclick = null;
            });
        }

        function allowDrop(ev) {
            ev.preventDefault();
            if (ev.target.id === 'tempDropZone') {
                ev.target.classList.add('drag-over');
            }
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
            ev.dataTransfer.effectAllowed = "move";
        }

        function drop(ev) {
            ev.preventDefault();

            // Retirer le style de drag-over
            if (ev.target.id === 'tempDropZone') {
                ev.target.classList.remove('drag-over');
            }

            var data = ev.dataTransfer.getData("text");
            var draggedElement = document.getElementById(data);

            if (!draggedElement) return;

            // Si on dépose dans la zone de suppression
            if (ev.target.id === 'tempDropZone') {
                draggedElement.remove();
                return;
            }

            // Si c'est un cours existant qu'on déplace
            if (draggedElement.classList.contains('course-item')) {
                // Vérifier si la case est vide ou non
                if (ev.target.classList.contains('timetable-slot')) {
                    // Vider la case avant d'ajouter le cours
                    ev.target.innerHTML = '';
                    ev.target.appendChild(draggedElement);
                } else if (ev.target.closest('.timetable-slot')) {
                    // Si on dépose sur un élément à l'intérieur de la case
                    var slot = ev.target.closest('.timetable-slot');
                    slot.innerHTML = '';
                    slot.appendChild(draggedElement);
                }
                return;
            }
        }
        
        document.getElementById('saveTimetableBtn').addEventListener('click', function () {
            var timetableData = [];
            var slots = document.querySelectorAll('.timetable-slot');

            slots.forEach(slot => {
                var courses = slot.querySelectorAll('.course-item');
                if (courses.length > 0) {
                    var day = slot.dataset.day;
                    var hour = slot.dataset.hour;
                    var hourEnd = getNextHour(hour);
                    var classId = document.getElementById("classSelect").value;

                    courses.forEach(course => {
                        var courseName = course.querySelector('strong').textContent;
                        var Profid = course.querySelector('div').textContent;


                        timetableData.push({
                            classId: classId,
                            day: day,
                            hour: hour,
                            hourEnd: hourEnd,
                            course: courseName,
                            Profid: Profid
                        });
                    });
                }
            });

                    function getNextHour(hourStr) {
            var parts = hourStr.split(':');
            var h = parseInt(parts[0]) + 1;
            return (h < 10 ? '0' + h : h) + ':00';
        }


            if (timetableData.length === 0) {
                document.getElementById("message_erreur").textContent = "Aucun cours à enregistrer";
                return;
            }

            var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();

            document.getElementById('confirmSaveBtn').onclick = function () {
                fetch('/Modules/Ajouter_emplois_du_temps', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(timetableData)
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            window.location.reload();
                        } else {
                            alert("Erreur lors de l'enregistrement: " + (data.message || ''));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert("Une erreur est survenue lors de l'enregistrement");
                    });

                modal.hide();
            };
        });
    </script>
}