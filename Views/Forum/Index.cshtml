@model Forum.Models.Messages

@{
    ViewData["Title"] = "Chat";
    Layout = "_Layout";
}

<h2>Chat de la Promo</h2>

<div id="messagesContainer" class="border p-3" style="height: 400px; overflow-y: scroll;">

</div>

<div class="form-group mt-3">
    <textarea id="messageInput" class="form-control" placeholder="Écrire un message..." rows="3"></textarea>
</div>

<div class="d-flex justify-content-between mt-2">
    <button id="sendMessageBtn" class="btn btn-primary">Envoyer</button>
</div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>

<script>;
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // Gestion de la connexion
    connection.start()
        .then(function () {
            console.log("Connexion réussie au ChatHub!");

            const classId = 1; 
            return connection.invoke("Message_send_and_echo_to_client", classId);
        })
        .catch(function (err) {
            console.error("Erreur de connexion SignalR: ", err.toString());
        });

    // Réception des nouveaux messages
    connection.on("ReceiveMessage", function (senderName, message, dateMessage) {
        addMessageToUI(senderName, message, dateMessage);
    });

    // Réception des messages historiques
    connection.on("MessagesLoaded", function (messages) {
        console.log("Messages chargés:", messages);
        const container = document.getElementById("messagesContainer");
        container.innerHTML = ""; 

        messages.forEach(msg => {
            addMessageToUI(msg.SenderName, msg.Message, msg.Date_message);
        });
    });

    function addMessageToUI(senderName, message, dateMessage) {
        const messageElement = document.createElement("div");
        messageElement.classList.add("message");

        // Formatage de la date
        const date = new Date(dateMessage);
        const formattedDate = date.toLocaleString();

        messageElement.innerHTML = `<strong>${senderName}</strong>: ${message} <em>${formattedDate}</em>`;

        // Récupérer le conteneur des messages
        const messagesContainer = document.getElementById("messagesContainer");
        messagesContainer.appendChild(messageElement);

        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    connection.on("MessagesLoaded", function (messages) {
        console.log("Messages chargés:", messages);
        const container = document.getElementById("messagesContainer");
        container.innerHTML = "";  

        messages.forEach(msg => {
            addMessageToUI(msg.SenderName, msg.Message, msg.Date_message);
        });
    });


    // Envoi de message
    document.getElementById("sendMessageBtn").addEventListener("click", function () {
        const message = document.getElementById("messageInput").value;
        const classId = 1; 

        if (message.trim() !== "") {
            addMessageToUI("Vous", message, new Date());

            connection.invoke("SendMessage", message, classId)
                .then(() => {
                    document.getElementById("messageInput").value = "";
                })
                .catch(err => {
                    console.error("Erreur lors de l'envoi:", err.toString());
                });
        }
    });


    </script>