@model Forum.Models.Messages

@{
    ViewData["Title"] = "Chat";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4">Chat de la Promo</h2>

    <div id="messagesContainer" class="border rounded p-3 bg-light" style="height: 400px; overflow-y: scroll;">
        <!-- Messages will appear here -->
    </div>

    <div class="form-group mt-3">
        <textarea id="messageInput" class="form-control" placeholder="Écrire un message..." rows="3"></textarea>
    </div>

    <div class="d-flex justify-content-between mt-2">
        <button id="sendMessageBtn" class="btn btn-primary">Envoyer</button>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>



<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

    function addMessageToUI(senderName, message, dateMessage, isCurrentUser = false) {
        const messageElement = document.createElement("div");
        messageElement.classList.add("d-flex", "mb-3");

        if (isCurrentUser) {
            messageElement.classList.add("justify-content-end");
            messageElement.innerHTML = `
                <div class="card bg-primary text-white" style="max-width: 75%;">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="card-title">${senderName || "Vous"}</strong>
                            <small class="text-white-50">${formatDate(dateMessage)}</small>
                        </div>
                        <p class="card-text mb-0">${message || ""}</p>
                    </div>
                </div>`;
        } else {
            messageElement.classList.add("justify-content-start");
            messageElement.innerHTML = `
                <div class="card bg-light" style="max-width: 75%;">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="card-title text-primary">${senderName || "Anonyme"}</strong>
                            <small class="text-muted">${formatDate(dateMessage)}</small>
                        </div>
                        <p class="card-text mb-0">${message || ""}</p>
                    </div>
                </div>`;
        }

        const messagesContainer = document.getElementById("messagesContainer");
        messagesContainer.appendChild(messageElement);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function formatDate(dateMessage) {
        try {
            const date = new Date(dateMessage);
            if (isNaN(date.getTime())) throw new Error("Invalid date");
            return date.toLocaleString('fr-FR', {
                hour: '2-digit',
                minute: '2-digit',
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        } catch (e) {
            return "à l'instant";
        }
    }

    connection.start()
        .then(function () {
            console.log("Connexion réussie au ChatHub!");
            const classId = 1;
            return connection.invoke("Message_send_and_echo_to_client", classId);
        })
        .catch(function (err) {
            console.error("Erreur de connexion SignalR: ", err.toString());
        });

    connection.on("MessagesLoaded", function (messages) {
        console.log("Messages reçus:", messages);

        if (!Array.isArray(messages)) {
            console.error("Les messages ne sont pas un tableau:", messages);
            return;
        }

        const container = document.getElementById("messagesContainer");
        container.innerHTML = "";

        messages.forEach(msg => {
            if (msg) {
                const isCurrentUser = msg.SenderName === "Vous" || msg.senderName === "Vous";
                addMessageToUI(
                    msg.SenderName || msg.senderName,
                    msg.Message || msg.message,
                    msg.Date_message || msg.dateMessage || msg.date,
                    isCurrentUser
                );
            }
        });
    });

    connection.on("ReceiveMessage", function (senderName, message, dateMessage) {
        addMessageToUI(senderName, message, dateMessage, senderName === "Vous");
    });

    document.getElementById("sendMessageBtn").addEventListener("click", function () {
        const message = document.getElementById("messageInput").value;
        const classId = 1;

        if (message.trim() !== "") {
            addMessageToUI("Vous", message, new Date(), true);

            connection.invoke("SendMessage", message, classId)
                .then(() => {
                    document.getElementById("messageInput").value = "";
                })
                .catch(err => {
                    console.error("Erreur lors de l'envoi:", err.toString());
                });
        }
    });


    document.getElementById("messageInput").addEventListener("keypress", function (e) {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            document.getElementById("sendMessageBtn").click();
        }
    });
</script>