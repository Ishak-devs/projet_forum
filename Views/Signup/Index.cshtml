@model Forum.Models.Utilisateurs
@{
    ViewData["Title"] = "Inscription Administrateur";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .auth-container {
            max-width: 500px;
            margin: 0 auto;
        }

        .auth-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .auth-header {
            position: relative;
        }

            .auth-header:after {
                content: "";
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 50px;
                height: 3px;
                background: #0d6efd;
                border-radius: 3px;
            }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .btn-primary {
            padding: 0.5rem 1.5rem;
            font-weight: 500;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="auth-container">
            <div class="auth-card card p-4">
                <!-- Header -->
                <div class="text-center auth-header mb-4">
                    <i class="fas fa-user-shield fa-2x text-primary mb-3"></i>
                    <h1 class="h3 fw-bold">Inscription Administrateur</h1>
                </div>

                <!-- Formulaire -->
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Nom">
                            <i class="fas fa-user-tag me-1 text-muted"></i>Nom
                        </label>
                        <input class="form-control" type="text" asp-for="Nom" placeholder="Entrez votre nom" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Nom)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Prenom">
                            <i class="fas fa-user me-1 text-muted"></i>Prénom
                        </label>
                        <input class="form-control" type="text" asp-for="Prenom" placeholder="Entrez votre prénom" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Prenom)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Email">
                            <i class="fas fa-envelope me-1 text-muted"></i>Email
                        </label>
                        <input class="form-control" type="email" asp-for="Email" placeholder="exemple@domain.com" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Email)</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium" asp-for="Motdepasse">
                            <i class="fas fa-lock me-1 text-muted"></i>Mot de passe
                        </label>
                        <input class="form-control" type="password" asp-for="Motdepasse" placeholder="Créez un mot de passe" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Motdepasse)</span>
                    </div>

                    <input type="hidden" asp-for="Role" value="admin" />

                    <div asp-validation-summary="All" ></div>

                    <button class="btn btn-primary w-100 py-2 fw-medium" type="submit">
                        <i class="fas fa-user-plus me-1"></i> Créer le compte
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">
                        Vous avez déjà un compte?
                        <a href="@Url.Action("Login", "Authentification")" class="text-primary fw-medium">Connectez-vous</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>