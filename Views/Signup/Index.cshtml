<div class="container mt-4">
    <form class="card p-4 shadow" method="post">

        <h1 class="text-center mb-4">Inscription administrateur</h1>

        <div class="mb-3">
            <label class="form-label" asp-for="Nom">Nom:</label>
            <input class="form-control" type="text" asp-for="Nom" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.Nom)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Prenom">Prénom:</label>
            <input class="form-control" type="text" asp-for="Prenom" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.Prenom)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Email">Email :</label>
            <input class="form-control" type="text" asp-for="Email" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.Email)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Motdepasse">Mot de passe :</label>
            <input class="form-control" type="password" asp-for="Motdepasse" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.Motdepasse)</span>
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="Role" value="admin" />
        <button class="btn btn-primary w-100" type="submit">S'inscrire</button>
    </form>
</div>
