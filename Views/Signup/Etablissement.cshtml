@model Forum.Models.Etablissements

@{
    ViewData["Title"] = "Inscription";
    Layout = "_Layout";
}

<h2>Inscription de l'Etablissement</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success")">
        @TempData["Message"]
    </div>
}
<form id="etablissementForm" method="post">


    <div class="form-group">
        <label asp-for="Region"></label>
        <select asp-for="Region" class="form-control" required />
        <option value="">-- Choisir une région --</option>
        <span asp-validation-for="Region" class="text-danger"></span>

        <label for="etablissements">Établissements disponibles</label>
        <select id="etablissements" class="form-control">
            <option value="">-- Choisir un établissement --</option>
        </select>
    </div>


    <div id="loader" class="text-center" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p>Chargement en cours...</p>
    </div>

    <button type="submit" class="btn btn-primary">Soumettre</button>
</form>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $('#Region').on('change', function () {
            const region = $(this).val();
            if (!region) return;

            $('#loader').show();

            $.ajax({
                 url: `https://data.education.gouv.fr/api/records/1.0/search/?dataset=fr-en-annuaire-education&rows=50&refine.nom_academie=${encodeURIComponent(region)}`,
                method: 'GET',
                success: function (data) {

                    //fonction pour append es etablissements dans nos balises
                    data.forEach(function () {
                         $('#loader').hide();
                         $('#RegionSelect').append(`<option value="${region.nom}">${region.nom}</option>`);
                         $('#etablissements').append(`<option value="${etablissements.nom}">${etablissements.nom}</option>`);
                    });
                },
                error: function () {
                    $('#etablissements').empty().append('<option>Erreur de chargement</option>');
                },
                complete: function () {
                    $('#loader').hide();
                }
            });
        });
    </script>
}

