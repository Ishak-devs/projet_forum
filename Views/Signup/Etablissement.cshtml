    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @model Forum.Models.Etablissements

    ViewData["Title"] = "Inscription";
    }

@if (ViewBag.Messagesuccess != null)
{
    <div class="alert alert-success">
        @ViewBag.Messagesuccess
    </div>
}

@if (ViewBag.MessageError != null)
{
    <div class="alert alert-danger">
        @ViewBag.MessageError
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container mt-4">
    <form class="card p-4 shadow" method="post">

        <h1 class="text-center mb-4">Inscrire mon établissement</h1>

        <div class="mb-3">
            <label class="form-label" asp-for="nom_etablissement">Nom de l’établissement :</label>
            <input class="form-control" type="text" asp-for="nom_etablissement" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.nom_etablissement)</span>
        </div>

        <hr />

        <h4 class="mb-3">Adresse de l’établissement</h4>

        <div class="mb-3">
            <label class="form-label" asp-for="numero_rue">Numéro de rue :</label>
            <input class="form-control" type="number" asp-for="numero_rue" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.numero_rue)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="nom_rue">Nom de la rue :</label>
            <input class="form-control" type="text" asp-for="nom_rue" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.nom_rue)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="code_postal">Code postal :</label>
            <input class="form-control" type="number" asp-for="code_postal" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.code_postal)</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ville">Ville :</label>
            <input class="form-control" type="text" asp-for="ville" />
            <span class="text-danger">@Html.ValidationMessageFor(e => e.ville)</span>
        </div>

        <button class="btn btn-primary w-100" type="submit">S'inscrire</button>
    </form>
</div>

