@model Forum.Models.Etablissements

@{
    ViewData["Title"] = "Inscription";
    Layout = "_Layout";
}

<h2>Inscription de l'Etablissement</h2>

@if (TempData["Message"] != null)
{
<div class="alert alert-@(TempData["MessageType"] ?? "success")">
    @TempData["Message"]
</div>
}
<form id="etablissementForm" method="post">


    <div class="form-group">
        <label asp-for="Region"></label>
        <select asp-for="Region" class="form-control" required>
            <option value="">-- Choisir une région --</option>
            <option value="Auvergne-Rhône-Alpes">Auvergne-Rhône-Alpes</option>
            <option value="Bourgogne-Franche-Comté">Bourgogne-Franche-Comté</option>
            <option value="Bretagne">Bretagne</option>
            <option value="Centre-Val de Loire">Centre-Val de Loire</option>
            <option value="Corse">Corse</option>
            <option value="Grand Est">Grand Est</option>
            <option value="Hauts-de-France">Hauts-de-France</option>
            <option value="Île-de-France">Île-de-France</option>
            <option value="Normandie">Normandie</option>
            <option value="Nouvelle-Aquitaine">Nouvelle-Aquitaine</option>
            <option value="Occitanie">Occitanie</option>
            <option value="Pays de la Loire">Pays de la Loire</option>
            <option value="Provence-Alpes-Côte d'Azur">Provence-Alpes-Côte d'Azur</option>
            <option value="Guadeloupe">Guadeloupe</option>
            <option value="Martinique">Martinique</option>
            <option value="Guyane">Guyane</option>
            <option value="La Réunion">La Réunion</option>
            <option value="Mayotte">Mayotte</option>
        </select>
        <span asp-validation-for="Region" class="text-danger"></span>

        <select asp-for="type_etablissement" id="type_etablissement" class="form-control" required>
            <option value="">-- Choisir un type --</option>
            <option value="Ecole">Ecole</option>
            <option value="Collège">Collège</option>
            <option value="Lycée">Lycée</option>
            <option value="EREA">EREA</option>
        </select>


        <label for="etablissements">Établissements disponibles</label>
        <select id="etablissements" class="form-control">
            <option value="">-- Choisir un établissement --</option>
        </select>
    </div>

    <div id="loader" class="text-center" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p>Chargement en cours...</p>
    </div>

    <div>
        <label asp-for="adresse">Adresse</label>
        <input type="text" id="adresse" class="form-control" readonly>
    </div>

    <div>
        <label asp-for="code_postal">Code postal</label>
        <input type="number" id="code_postal" class="form-control" readonly>
    </div>

    <div>
        <label asp-for="commune">commune</label>
        <input type="text" id="commune" class="form-control" readonly>
    </div>


    <input type="submit" class="btn btn-primary" value="Valider">
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let etablissementsData = {};

        $(document).ready(function () {
            $('#Region, #type_etablissement').change(function () {
                const region = $('#Region').val();
                const typeEtablissement = $('#type_etablissement').val();

                if (!region || !typeEtablissement) {
                    $('#etablissements').html('<option value="">-- Sélectionnez région et type --</option>');
                    return;
                }

                $('#loader').show();
                $('#etablissements').html('<option value="">Chargement...</option>');
                etablissementsData = {};

                $.ajax({
                    url: `https://data.education.gouv.fr/api/records/1.0/search/?dataset=fr-en-annuaire-education&rows=50&refine.nom_academie=${encodeURIComponent(region)}&refine.type_etablissement=${encodeURIComponent(typeEtablissement)}`,
                    method: 'GET',
                    success: function (data) {
                        $('#etablissements').empty();
                        if (data.nhits === 0) {
                            $('#etablissements').append('<option value="">Aucun établissement trouvé</option>');
                        } else {
                            $('#etablissements').append('<option value="">-- Sélectionnez --</option>');
                            data.records.forEach(function (record) {
                                const id = record.recordid;
                                const nom = record.fields.nom_etablissement || 'Établissement sans nom';
                                const commune = record.fields.commune || '';
                                const adresse = record.fields.adresse || '';
                                const code_postal = record.fields.code_postal || '';

                                etablissementsData[id] = {
                                    adresse,
                                    commune,
                                    codePostal: code_postal
                                };

                                $('#etablissements').append(
                                    `<option value="${id}">${nom} (${commune})</option>`
                                );
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Erreur AJAX:", status, error);
                        $('#etablissements').html('<option value="">Erreur de connexion</option>');
                    },
                    complete: function () {
                        $('#loader').hide();
                    }
                });
            });

            $('#etablissements').change(function () {
                const selectedId = $(this).val();
                const data = etablissementsData[selectedId];

                if (data) {
                    $('#nom_rue').val(data.adresse);
                    $('#code_postal').val(data.codePostal);
                    $('#ville').val(data.commune);
                } else {
                    $('#nom_rue, #code_postal, #ville').val('');
                }
            });
        });
    </script>
}
