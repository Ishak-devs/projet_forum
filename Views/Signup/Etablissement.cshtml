@model Forum.Models.Etablissements

@{
    ViewData["Title"] = "Inscription";
    Layout = "_Layout";
}

<h2>Inscription de l'Etablissement</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success")">
        @TempData["Message"]
    </div>
}
<form id="etablissementForm" method="post">


    <div class="form-group">
        <label asp-for="Region"></label>
        <select asp-for="Region" class="form-control" required>
            <option value="">-- Choisir une région --</option>
            <option value="Auvergne-Rhône-Alpes">Auvergne-Rhône-Alpes</option>
            <option value="Bourgogne-Franche-Comté">Bourgogne-Franche-Comté</option>
            <option value="Bretagne">Bretagne</option>
            <option value="Centre-Val de Loire">Centre-Val de Loire</option>
            <option value="Corse">Corse</option>
            <option value="Grand Est">Grand Est</option>
            <option value="Hauts-de-France">Hauts-de-France</option>
            <option value="Île-de-France">Île-de-France</option>
            <option value="Normandie">Normandie</option>
            <option value="Nouvelle-Aquitaine">Nouvelle-Aquitaine</option>
            <option value="Occitanie">Occitanie</option>
            <option value="Pays de la Loire">Pays de la Loire</option>
            <option value="Provence-Alpes-Côte d'Azur">Provence-Alpes-Côte d'Azur</option>
            <option value="Guadeloupe">Guadeloupe</option>
            <option value="Martinique">Martinique</option>
            <option value="Guyane">Guyane</option>
            <option value="La Réunion">La Réunion</option>
            <option value="Mayotte">Mayotte</option>
        </select>
        <span asp-validation-for="Region" class="text-danger"></span>


        <label asp-for="type_etablissement">Type d'établissement</label>
        <select asp-for="type_etablissement" , id="type_etablissement" class="form-control" required>
            <option value="">-- Choisir un type --</option>
            <option value="lycée">Lycée</option>
            <option value="collège">Collège</option>
            <option value="école privée">École privée</option>
        </select>


        <label for="etablissements">Établissements disponibles</label>
        <select id="etablissements" class="form-control">
            <option value="">-- Choisir un établissement --</option>
        </select>
    </div>


    <div id="loader" class="text-center" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <p>Chargement en cours...</p>
    </div>

    <button type="submit" class="btn btn-primary">Soumettre</button>
</form>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>


            $.ajax({
                url: `https://data.education.gouv.fr/api/records/1.0/search/?dataset=fr-en-annuaire-education&rows=50&refine.nom_academie=${encodeURIComponent(region)}&refine.type_etablissement=${encodeURIComponent(typeEtablissement)}`
                method: 'GET',
                success: function (data) {

                      
                         data.records.forEach(function (record) {
                    const nomEtablissement = record.fields.nom_etablissement;
                    const idEtablissement = record.fields.idEtablissement;

                       $('#etablissements').append(`<option value="${idEtablissement}">${nomEtablissement}</option>`);

                    });
                },
                error: function () {
                    $('#etablissements').empty().append('<option>Erreur de chargement</option>');
                },
                complete: function () {
                    $('#loader').hide();
                }
            });
        });
    </script>
}

