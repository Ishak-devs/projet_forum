@model Forum.Models.Utilisateurs

@{
    ViewData["Title"] = "Inscription utilisateur";
    Layout = "_Layout";
}

<h2>Inscription d’un utilisateur</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

<form method="post">
    <div class="form-group">
        <label asp-for="Nom">Nom</label>
        <input asp-for="Nom" class="form-control" required />
        <span asp-validation-for="Nom" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Prenom">Prénom</label>
        <input asp-for="Prenom" class="form-control" required />
        <span asp-validation-for="Prenom" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" class="form-control" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Motdepasse">Mot de passe</label>
        <input asp-for="Motdepasse" class="form-control" type="password" required />
        <span asp-validation-for="Motdepasse" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Role">Rôle</label>
        <select asp-for="Role" class="form-control">
            <option value="Etudiant">Etudiant</option>
            <option value="Professeur">Professeur</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <label for="Sections">Sections</label>
    <select asp-for="Section" class="form-select" id="">
            <option value="Seconde_general">Seconde Générale</option>
            <option value="Seconde_pro">Seconde Pro</option>
            <option value="Premiere_general">Première Générale</option>
            <option value="Premiere_general">Première Pro</option>
            <option value="Terminale_general">Terminale Générale</option>
            <option value="Terminale_pro">Terminale Pro</option>
    </select>

    <button type="submit" class="btn btn-primary">Valider l'inscription</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}