@model Forum.Models.Utilisateurs
@{
    ViewData["Title"] = "Inscription utilisateur";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .auth-container {
            max-width: 600px;
            margin: 0 auto;
        }

        .auth-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .auth-header {
            position: relative;
        }

            .auth-header:after {
                content: "";
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 50px;
                height: 3px;
                background: #0d6efd;
                border-radius: 3px;
            }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .btn-primary {
            padding: 0.5rem 1.5rem;
            font-weight: 500;
        }

        .table-responsive {
            border-radius: 8px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #dee2e6;
        }

        th {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        /* Style pour le champ caché */
        .hidden-field {
            display: none;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="auth-container">
            <div class="auth-card card p-4">
                <!-- Header -->
                <div class="text-center auth-header mb-4">
                    <i class="fas fa-user-plus fa-2x text-primary mb-3"></i>
                    <h1 class="h3 fw-bold">Inscription Utilisateur</h1>
                </div>

                <!-- Messages d'alerte -->
                @if (ViewBag.SuccessMessage != null)
                {
                <div class="alert alert-success alert-dismissible fade show">
                    @ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                <div class="alert alert-danger alert-dismissible fade show">
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                foreach (var error in modelState.Errors)
                                {
                        <li>@error.ErrorMessage</li>
                                }
                            }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                }

                @if (ViewBag.Liste_user != null)
{
                <div class="mb-4">
                    <h4 class="mb-3"><i class="fas fa-users me-2"></i>Utilisateurs de l'établissement</h4>

                    <form asp-action="SupprimerUtilisateur" method="post" onsubmit="return confirm('Confirmer la suppression ?');">
                        <select class="form-select mb-3" aria-label="Liste des utilisateurs" name="id" required>
                            <option value="" disabled selected>-- Sélectionnez un utilisateur --</option>
                            @foreach (var user in ViewBag.Liste_user)
                {
                            <option value="@user.Id_utilisateur">
                                @user.Prenom @user.Nom (@user.Email)
                            </option>
                }
                        </select>

                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash-alt me-1"></i> Supprimer
                        </button>
                    </form>
                </div>
}


                <!-- Formulaire -->
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Nom">
                            <i class="fas fa-user-tag me-1 text-muted"></i>Nom
                        </label>
                        <input class="form-control" type="text" asp-for="Nom" placeholder="Entrez votre nom" required />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Nom)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Prenom">
                            <i class="fas fa-user me-1 text-muted"></i>Prénom
                        </label>
                        <input class="form-control" type="text" asp-for="Prenom" placeholder="Entrez votre prénom" required />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Prenom)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Email">
                            <i class="fas fa-envelope me-1 text-muted"></i>Email
                        </label>
                        <input class="form-control" type="email" asp-for="Email" placeholder="exemple@domain.com" required />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Email)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Motdepasse">
                            <i class="fas fa-lock me-1 text-muted"></i>Mot de passe
                        </label>
                        <input class="form-control" type="password" asp-for="Motdepasse" placeholder="Créez un mot de passe" required />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Motdepasse)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium" asp-for="Role">
                            <i class="fas fa-user-tie me-1 text-muted"></i>Rôle
                        </label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="Etudiant">Etudiant</option>
                            <option value="Professeur">Professeur</option>
                        </select>
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Role)</span>
                    </div>

                    <div class="mb-3 hidden-field" id="matiereField">
                        <label class="form-label fw-medium" asp-for="Matiere">
                            <i class="fas fa-book me-1 text-muted"></i>Matière
                        </label>
                        <input class="form-control" type="text" asp-for="Matiere" placeholder="Entrez la matière" />
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Matiere)</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium" asp-for="Section">
                            <i class="fas fa-graduation-cap me-1 text-muted"></i>Section
                        </label>
                        <select asp-for="Section" class="form-select">
                            <option value="Seconde_general">Seconde Générale</option>
                            <option value="Seconde_pro">Seconde Pro</option>
                            <option value="Premiere_general">Première Générale</option>
                            <option value="Premiere_pro">Première Pro</option>
                            <option value="Terminale_general">Terminale Générale</option>
                            <option value="Terminale_pro">Terminale Pro</option>
                        </select>
                        <span class="text-danger small">@Html.ValidationMessageFor(e => e.Section)</span>
                    </div>

                    <button class="btn btn-primary w-100 py-2 fw-medium" type="submit">
                        <i class="fas fa-user-plus me-1"></i> Valider l'inscription
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const matiereField = document.getElementById('matiereField');

            // Fonction pour gérer la visibilité du champ matière
            function toggleMatiereField() {
                if (roleSelect.value === 'Professeur') {
                    matiereField.classList.remove('hidden-field');
                    matiereField.querySelector('input').setAttribute('required', '');
                } else {
                    matiereField.classList.add('hidden-field');
                    matiereField.querySelector('input').removeAttribute('required');
                }
            }

            // Écouteur d'événement pour le changement de rôle
            roleSelect.addEventListener('change', toggleMatiereField);

            // Appel initial pour définir l'état correct au chargement
            toggleMatiereField();
        });
    </script>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
    }
</body>
</html>