@{
    ViewData["Title"] = "Etablissement Etape 2";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container my-5">
        <h2>Etape 2 de l'inscription</h2>

        <!-- Loader Bootstrap -->
        <div id="loader" class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>

        <!-- Contenu de la page (peut être caché au début) -->
        <div id="content" class="d-none">
            <h3>Bienvenue dans l'étape 2</h3>
            <p>Complétez les informations suivantes...</p>
            <!-- Ajoutez ici votre formulaire ou tout autre contenu -->
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Simuler le chargement et masquer le loader après un délai (par exemple 3 secondes)
        setTimeout(function() {
            document.getElementById("loader").classList.add("d-none"); // Masquer le loader
            document.getElementById("content").classList.remove("d-none"); // Afficher le contenu
        }, 3000); // 3000 ms = 3 secondes
    </script>
</body>
</html>
